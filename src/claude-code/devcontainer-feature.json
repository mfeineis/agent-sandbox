{
  "id": "claude-code",
  "version": "0.2.2",
  "dependsOn": {
    "ghcr.io/mfeineis/agent-sandbox/base:0.2.2": {}
  },
  "name": "Claude Code Agent Sandbox Feature",
  "description": "Installs the Claude Code CLI into an Agent Sandbox",
  "options": {
    "claudeCodeVersion": {
      "default": "2.1.217",
      "type": "string"
    }
  },
  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
