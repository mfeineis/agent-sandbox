{
  "name": "Claude Code CLI (Agent Sandbox)",
  "id": "claude-code",
  "version": "0.1.0",
  "description": "Installs the Claude Code CLI into an agent sandbox",
  "options": {
    "claudeCodeVersion": {
      "default": "2.1.146",
      "type": "string"
    },
    "gitUser": {
      "default": "Claude Code (default)",
      "type": "string"
    },
    "gitEmail": {
      "default": "claude.code@agent.sandbox",
      "type": "string"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },
  "mounts": [
    { "source": "claude-code-bashhistory-${devcontainerId}", "target": "/commandhistory", "type": "volume" },
    { "source": "claude-code-config-${devcontainerId}", "target": "/home/vscode/.claude", "type": "volume" },
    { "source": "${localWorkspaceFolder}", "target": "/workspace", "type": "bind" }
  ]
}
