{
  "id": "claude-code",
  "version": "0.3.0",
  "dependsOn": {
    "ghcr.io/mfeineis/agent-sandbox/base:0.3.0": {}
  },
  "name": "Claude Code Agent Sandbox Feature",
  "description": "Installs the Claude Code CLI into an Agent Sandbox",
  "options": {
    "cliVersion": {
      "default": "2.1.308",
      "type": "string"
    }
  },
  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}