{
  "name": "Claude Code CLI (Agent Sandbox)",
  "id": "claude-code",
  "version": "0.1.9",
  "dependsOn": {
    "ghcr.io/mfeineis/agent-sandbox/base:0.1.9": {
      "gitUser": "Claude Code",
      "gitEmail": "claude.code@agent.sandbox"
    }
  },
  "name": "Claude Code Agent Sandbox Feature",
  "description": "Installs the Claude Code CLI into an Agent Sandbox",
  "options": {
    "claudeCodeVersion": {
      "default": "2.1.150",
      "type": "string"
    }
  },
  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
