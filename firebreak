  "remoteEnv": {
    "TZ": "${localEnv:TZ:Europe/Berlin}"
  },
  "workspaceFolder": "/home/vscode"
}
DEVCONFOOT
      } >"$DEVCON_STORE/devcontainer.json"
    fi

    if [ ! -f "$DEVCON_STORE/compose.yml" ]; then
      {
        cat <<'COMPOSEHEAD'
