set -eu
umask 077
profile=${1:?Expected profile}
selected_runtime=${2:?Expected OCI runtime}
case $profile in unsafe|models|offline) :;; *) echo "Unexpected profile: $profile" >&2; exit 2;; esac
case $selected_runtime in crun|runsc) :;; *) echo "Unexpected OCI runtime: $selected_runtime" >&2; exit 2;; esac
case $profile in unsafe) pull_policy=missing;; *) pull_policy=never;; esac
