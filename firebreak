  say "Host QEMU log: $VM_LOG"
  say "Login on video/serial terminal: alpine; password via '$0 $NAME console-password' in another terminal."
  say 'If cloud-init failed before creating the user, the password may NOT be active.'
  say "SSH recovery (inside Alpine, using doas): mkdir -p /mnt/fbseed; mount -t vfat /dev/sdb1 /mnt/fbseed; sh /mnt/fbseed/ssh-recovery.sh"
  say 'Debug mode stays running without SSH. Quit QEMU or interrupt Firebreak to stop.'
