  chmod 600 "$PROXY"/*
}

cmd_config() {
  action=${1:-}
  shift || true
  case $action in
    init)
      ensure_dirs
      init_conf
      load_conf
      ensure_ignored
      ensure_editorconfig
      render_proxy_config

      if [ "${1:-}" = --install-deps ]; then
        [ "$(uname -s)" = Darwin ] || panic $EX_OSERR 'brew install is only available on macOS'
        require brew
        brew install qemu socat squid gnupg coreutils
      elif [ "$#" -ne 0 ]; then
        panic $EX_USAGE "unknown argument: $1"
      fi
      info "Initialized $CONF and $STORE (no VM created)."
      ;;
    apply|upgrade)
      [ -f "$CONF" ] || panic $EX_NOINPUT 'Run config init first'
      ensure_dirs
      load_conf
      ensure_ignored

      if [ "$#" -ne 0 ]; then
        panic $EX_USAGE "unknown argument: $1"
      fi
      if [ "$action" = "upgrade" ]; then
        # Discover the highest available revision of the exact configured release.
        require curl
        require sort
        require sed

        page=$(curl -fsSL "${ALPINE_MIRROR%/}/v$(printf %s "$ALPINE_VERSION" | cut -d. -f1-2)/releases/cloud/") || panic $EX_PROTOCOL 'Unable to query Alpine cloud image index'
        latest=$(printf '%s\n' "$page" | grep -o "generic_alpine-${ALPINE_VERSION}-aarch64-uefi-cloudinit-r[0-9][0-9]*.qcow2" | sort -u | sed 's/.*-r\([0-9][0-9]*\).qcow2/r\1/' | sort -t r -k2,2n | tail -n 1)
        [ -n "$latest" ] || panic $EX_CONFIG 'No matching cloud image revision in index'
        if [ "$latest" != "$ALPINE_REVISION" ]; then
          # Keep all unknown keys, comments and user changes untouched.
          sed "s/^alpine_revision=.*/alpine_revision=$latest/" "$CONF" | write_if_changed "$CONF"
          ALPINE_REVISION=$latest
        fi
      fi
      render_proxy_config
      for disk in "$VMS"/*.qcow2; do
        [ -f "$disk" ] || continue
        base=${disk##*/}
        configure_vm_paths "${base%.qcow2}"
        [ ! -d "$disk.lock" ] || panic $EX_USAGE "Stop sandbox $NAME before updating its seed"
        render_seed "$NAME"
      done
      info 'Configuration reconciled on disk; guest runtime policies apply on next VM start.'
    ;;
    proxy-check)
      case ${1:-} in
        ''|--online) : ;;
        *) panic $EX_USAGE 'proxy-check accepts only --online' ;;
      esac
      [ "$#" -le 1 ] || panic $EX_USAGE 'proxy-check accepts only --online'
      online=${1:-no}
      [ -f "$CONF" ] || panic $EX_NOINPUT 'Run config init first'

      ensure_dirs
      load_conf
      render_proxy_config

      # Isolated subshell: the real VM supervisor's PID/trap state is untouched.
      (
        SQUID_PID=
        trap '[ -z "$SQUID_PID" ] || { kill "$SQUID_PID" 2>/dev/null || :; wait "$SQUID_PID" 2>/dev/null || :; }' 0
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM
        start_squid
        if [ "$online" = --online ]; then
          require curl
          info 'Testing the actual setup proxy against the gVisor release endpoint...'
          if ! curl --fail --show-error --silent --head --location \
              --connect-timeout 20 --max-time 40 \
              --proxy "http://127.0.0.1:$SQUID_PORT" --noproxy '' \
              'https://storage.googleapis.com/gvisor/releases/release/latest/aarch64/gvisor.tar.bz2' \
              > "$PROXY/online-check.log" 2>&1; then
            warn 'Proxy online check failed:'
            tail -n 15 "$PROXY/online-check.log" >&2 || :
            warn 'Recent Squid transactions:'
            tail -n 15 "$PROXY/access.log" >&2 2>/dev/null || :
            panic $EX_IOERR 'Setup proxy cannot reach gVisor (no VM needed)'
          fi
          info 'gVisor endpoint reachable through Squid.'
        fi
        info 'Squid policy and foreground startup OK; test process stopped.'
      )
    ;;
    *) panic $EX_USAGE 'Expected: config init|apply|upgrade' ;;
    # *) panic $EX_USAGE 'Expected: config init|apply|upgrade|proxy-check';;
  esac
}

verify_gpg_signature() {
  fingerprint=$1
  keyfile=$2
  sig=$3
  bin=$4

  # Normalize fingerprint: remove whitespace, uppercase hex.
  expected=$(printf '%s' "$fingerprint" |
    tr -d '[:space:]' |
    tr '[:lower:]' '[:upper:]')

  # Reject malformed fingerprints.
  case "$expected" in
    *[!0123456789ABCDEF]*|'') panic $EX_SOFTWARE "Invalid fingerprint" ;;
  esac

  case ${#expected} in
    40|64) ;;
    *) panic $EX_SOFTWARE "Unexpected fingerprint length" ;;
  esac

  # Isolated GPG environment.
  tmpdir=$(mktemp -d) || panic $EX_CANTCREAT "could not create temp directory"
  trap 'rm -rf "$tmpdir"' 0
  trap 'exit 1' 1 2 3 15

  chmod 700 "$tmpdir" || panic $EX_CANTCREAT "could not chmod temp directory"

  # Import the supplied public key
  gpg --homedir "$tmpdir" --batch --no-tty \
    --import "$keyfile" || panic $EX_SOFTWARE "pubkey import failed"

  actual=$(
    gpg --homedir "$tmpdir" --batch --with-colons --fingerprint --list-keys |
    awk -F: '
      $1 == "pub" {
        count++
        want_fpr = 1
        next
      }
      $1 == "fpr" && want_fpr {
        fingerprint = $10
        want_fpr = 0
      }
      END {
        if (count != 1 || fingerprint == "")
          exit 1
        print fingerprint
      }
    '
  ) || panic $EX_SOFTWARE "could not extract exactly one required primary-key fingerprint"

  if [ "$actual" != "$expected" ]; then
    { printf 'Key fingerprint mismatch!\n' \
    ; printf 'Expected: %s\n' "$expected" \
    ; printf 'Actual:   %s\n' "$actual" \
    ; \
    } | panic $EX_SOFTWARE
  fi

  # Cryptographically verify the signature, we trust it because we do
  # our own explicit fingerprint validation and have obtained both
  # fingerprint and public key by hand.
  # Keeping the machine-readable status for the next check.
  if ! gpg --homedir "$tmpdir" --batch --no-tty \
    --trust-model always --assert-signer "$expected" --quiet \
    --status-fd 1 --verify "$sig" "$bin" \
    > "$tmpdir/status"
  then
    panic $EX_SOFTWARE "Signature verification failed!"
  fi

  # Verify the signer's primary-key fingerprint.
  # Require exactly one valid signature from our expected key.
  if ! awk -v expected="$expected" '
    $1 == "[GNUPG:]" && $2 == "VALIDSIG" {
      count++
      # Last field is the primary-key fingerprint.
      # Fall back to signing-key fingerprint if absent.
      primary = (NF >= 12 ? $12 : $3)
      if (primary != expected)
        mismatch = 1
    }
    END {
      if (count != 1 || mismatch)
        exit 1
    }
    ' "$tmpdir/status"
  then
    panic $EX_SOFTWARE "Signature signer mismatch!"
  fi

  info "Signature verified with expected key: $expected"
}

