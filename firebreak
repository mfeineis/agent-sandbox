#!/bin/sh
# Firebreak: a single-file, POSIX-sh macOS/aarch64 development VM manager.
# The accompanying tests have no QEMU, root, or network requirement.
set -eu
umask 077

VERSION=0.3.0
BUILD=1051
STORE_NAME=firebreak
CONF=firebreak.conf
ROOT=$(pwd -P)
STORE=$ROOT/.devcontainer/firebreak
IMAGES=$STORE/img
VMS=$STORE/vm
SEEDS=$STORE/seeds
SECRETS=$STORE/secrets
SHARED=$STORE/shared
TMP=$STORE/tmp
PROXY=$STORE/proxy
SYNC=$STORE/sync

say() { printf '%s\n' "$*" >&2; }
die() { say "firebreak: $*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing '$1' (try: brew install ${2:-$1})"; }
# Homebrew keeps Squid in opt/squid/sbin (usually outside the interactive PATH).
# Return an executable PATH, never rely on shell aliases or exported functions.
resolve_squid() (
  if [ -n "${FIREBREAK_SQUID:-}" ]; then
    case $FIREBREAK_SQUID in /*) :;; *) die 'FIREBREAK_SQUID must be an absolute path';; esac
    [ -f "$FIREBREAK_SQUID" ] && [ -x "$FIREBREAK_SQUID" ] || die "Squid not executable: $FIREBREAK_SQUID"
    printf '%s\n' "$FIREBREAK_SQUID"
    exit 0
  fi
  candidate=$(command -v squid 2>/dev/null) || candidate=
  # Ignore alias/function output: only absolute, executable file paths are valid.
  case $candidate in /*) if [ -f "$candidate" ] && [ -x "$candidate" ]; then printf '%s\n' "$candidate"; exit 0; fi;; esac
  if command -v brew >/dev/null 2>&1; then
    prefix=$(brew --prefix squid 2>/dev/null) || prefix=
    if [ -n "$prefix" ] && [ -f "$prefix/sbin/squid" ] && [ -x "$prefix/sbin/squid" ]; then
      printf '%s\n' "$prefix/sbin/squid"
      exit 0
    fi
  fi
  for candidate in /opt/homebrew/opt/squid/sbin/squid /usr/local/opt/squid/sbin/squid; do
    if [ -f "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      exit 0
    fi
  done
  die "Missing 'squid' (try: brew install squid; or set FIREBREAK_SQUID=/absolute/path/to/squid)"
)
valid_name() { case $1 in ''|*[!a-zA-Z0-9_.-]*|.|..|.*) return 1;; esac; return 0; }
valid_port() { case $1 in ''|*[!0-9]*) return 1;; esac; [ "$1" -gt 0 ] && [ "$1" -le 65535 ]; }
valid_dnsname() { case $1 in ''|*[!a-zA-Z0-9.-]*|.*|*..*|*.) return 1;; esac; return 0; }
valid_list() { case $1 in *[!a-zA-Z0-9,_.-]*) return 1;; esac; return 0; }
valid_version() { printf '%s\n' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; }
# Functions using scratch variables run in subshells, avoiding global POSIX-sh scoping hazards.
mac_from_string() (
  need shasum
  hash=$(printf '%s' "$1" | shasum -a 256 | awk '{print $1}')
  printf '52:54:00:%s:%s:%s\n' "$(printf '%s' "$hash" | cut -c1-2)" "$(printf '%s' "$hash" | cut -c3-4)" "$(printf '%s' "$hash" | cut -c5-6)"
)
rand_hex() { od -An -N "$1" -tx1 /dev/urandom | tr -d ' \n'; }
write_if_changed() { # stdin -> path; replace atomically and only on actual changes
  dest=$1
  mkdir -p "$(dirname "$dest")"
  temp=$(mktemp "${dest}.XXXXXX") || return 1
  cat > "$temp"
  if [ -f "$dest" ] && cmp -s "$temp" "$dest"; then rm -f "$temp"; else mv -f "$temp" "$dest"; fi
}

# Stable defaults; never source user-supplied configuration as shell code.
ALPINE_VERSION=3.24.1
ALPINE_REVISION=r0
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
GIT_USER='Firebreak Agent'
GIT_EMAIL=agent@firebreak.invalid
GIT_IMPORT=snapshot
STORAGE=ephemeral
VM_MEMORY=10240
VM_CPUS=4
VM_SIZE=60G
SSH_PORT=2222
FORGEJO_PORT=3001
SQUID_PORT=3128
SQUID_MODELS_PORT=3129
NETWORK_WORK=offline
BOOT_TIMEOUT=0
RUNTIME_UNSAFE=crun
RUNTIME_OFFLINE=runsc
RUNTIME_MODELS=runsc
MODELS=ollama
FORGEJO_PACKAGE=forgejo
GUEST_USER=alpine
SBX_OCI_REGISTRY_MIRRORS=${SBX_OCI_REGISTRY_MIRRORS:-}
FIRMWARE_VERSION=firmware-v202605-edk2-stable
FIRMWARE_SHA256=17013c4f9b1f640685c0f0ad24a32d63b8e63a0fb30f33e61e4f6c3abffc65df
FIRMWARE_URL=https://github.com/mfeineis/agent-sandbox/releases/download/firmware-v202605-edk2-stable/QEMU_EFI.fd
ALPINE_FPR='F26A DFAD BAE7 02EF 7AF6 3745 9DA7 EF23 BFFC DF22'

read_config() {
  [ -f "$ROOT/$CONF" ] || return 0
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case $key in ''|\#*) continue;; esac
    # Restricted plain KEY=value format, not shell source; values cannot run commands.
    case $key in
      alpine_version) ALPINE_VERSION=$value;;
      alpine_revision) ALPINE_REVISION=$value;;
      alpine_mirror) ALPINE_MIRROR=$value;;
      git_user) GIT_USER=$value;; git_email) GIT_EMAIL=$value;;
      git_import) GIT_IMPORT=$value;;
      storage) STORAGE=$value;; memory_mb) VM_MEMORY=$value;; cpus) VM_CPUS=$value;; disk_size) VM_SIZE=$value;;
      ssh_port) SSH_PORT=$value;; forgejo_port) FORGEJO_PORT=$value;;
      squid_port) SQUID_PORT=$value;; squid_models_port) SQUID_MODELS_PORT=$value;;
      network_work) NETWORK_WORK=$value;; models) MODELS=$value;;
      boot_timeout) BOOT_TIMEOUT=$value;;
      runtime_unsafe) RUNTIME_UNSAFE=$value;;
      runtime_offline) RUNTIME_OFFLINE=$value;;
      runtime_models) RUNTIME_MODELS=$value;;
      forgejo_package) FORGEJO_PACKAGE=$value;;
      *) : ;; # Unknown keys are deliberately ignored and preserved.
    esac
  done < "$ROOT/$CONF"
}
validate_config() {
  valid_version "$ALPINE_VERSION" || die 'Invalid alpine_version'
  case $ALPINE_REVISION in r[0-9]*) case ${ALPINE_REVISION#r} in *[!0-9]*|'') die 'Invalid alpine_revision';; esac;; *) die 'Invalid alpine_revision';; esac
  case $ALPINE_MIRROR in https://*) :;; *) die 'Alpine mirror must use HTTPS';; esac
  case $ALPINE_MIRROR in *[!a-zA-Z0-9/_.:-]*) die 'Invalid Alpine mirror URL';; esac
  case $STORAGE in ephemeral|persistent) :;; *) die 'storage must be ephemeral or persistent';; esac
  case $GIT_IMPORT in snapshot|shallow|full) :;; *) die 'git_import must be snapshot, shallow, or full';; esac
  case $NETWORK_WORK in offline|models) :;; *) die 'network_work must be offline or models';; esac
  case $BOOT_TIMEOUT in ''|*[!0-9]*) die 'boot_timeout must be 0-30 seconds';; esac
  [ "$BOOT_TIMEOUT" -le 30 ] || die 'boot_timeout must be 0-30 seconds'
  for selected in "$RUNTIME_UNSAFE" "$RUNTIME_OFFLINE" "$RUNTIME_MODELS"; do
    case $selected in crun|runsc) :;; *) die "Unsupported OCI runtime: $selected (expected crun or runsc)";; esac
  done
  case $FORGEJO_PACKAGE in forgejo|forgejo-lts) :;; *) die 'unsupported Forgejo package';; esac
  valid_list "$MODELS" || die 'models must be comma-separated identifiers'
  for n in "$SSH_PORT" "$FORGEJO_PORT" "$SQUID_PORT" "$SQUID_MODELS_PORT"; do valid_port "$n" || die "invalid port $n"; done
  for n in "$VM_MEMORY" "$VM_CPUS"; do case $n in ''|*[!0-9]*) die "invalid integer $n";; esac; [ "$n" -gt 0 ] || die 'values must be positive'; done
  case $VM_SIZE in *[!0-9GM]*) die 'disk_size must be an integer followed by G or M';; esac
  case $GIT_USER$GIT_EMAIL in *'\n'*|*'\r'*) die 'invalid Git identity';; esac
  # Model policies never accept arbitrary proxy targets from inside the guest.
  saved_ifs=$IFS; IFS=,; set -- $MODELS; IFS=$saved_ifs
  for model do case $model in ''|ollama|anthropic|openai|openrouter) :;; *) die "unknown model provider: $model";; esac; done
}
load() { read_config; validate_config; }
ensure_dirs() { mkdir -p "$IMAGES" "$VMS" "$SEEDS" "$SECRETS" "$SHARED" "$TMP" "$PROXY" "$SYNC"; }
init_conf() {
  if [ ! -f "$ROOT/$CONF" ]; then
    cat > "$ROOT/$CONF" <<'EOF_CONF'
# Firebreak configuration, plain KEY=value (not a shell script).
# Keys not recognized by this version are preserved when updating.
alpine_version=3.24.1
alpine_revision=r0
alpine_mirror=https://dl-cdn.alpinelinux.org/alpine
storage=ephemeral
network_work=offline
boot_timeout=0
runtime_unsafe=crun
runtime_offline=runsc
runtime_models=runsc
models=ollama
forgejo_package=forgejo
forgejo_port=3001
ssh_port=2222
squid_port=3128
squid_models_port=3129
memory_mb=10240
cpus=4
disk_size=60G
git_user=Firebreak Agent
git_email=agent@firebreak.invalid
git_import=snapshot
EOF_CONF
    chmod 600 "$ROOT/$CONF"
  fi
}
ensure_ignored() {
  if [ ! -e "$ROOT/.gitignore" ]; then : > "$ROOT/.gitignore"; fi
  for pattern in '.devcontainer/firebreak/' '.env'; do
    grep -Fqx "$pattern" "$ROOT/.gitignore" || printf '%s\n' "$pattern" >> "$ROOT/.gitignore"
  done
}
ensure_editorconfig() {
  if [ ! -f "$ROOT/.editorconfig" ]; then
    cat > "$ROOT/.editorconfig" <<'EOF_EDITORCFG'
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

EOF_EDITORCFG
  fi
}
ssh_opts() { # calls should use positional array construction via set --, never word-splitting
  :
}
vm_paths() {
  valid_name "$1" || die "invalid sandbox name: $1"
  NAME=$1
  DISK=$VMS/$NAME.qcow2
  SEED=$SEEDS/$NAME
  SECRET=$SECRETS/$NAME
  KNOWN=$SECRET/known_hosts
  CLIENT=$SECRET/id_ed25519_client
  HOSTKEY=$SECRET/id_ed25519_vmhost
  VM_SOCKET=$TMP/$NAME.podman.sock
  ACTIVE_MODE=$TMP/$NAME.active-network-mode
  SYNC_DIR=$SYNC/$NAME
}
ensure_keys() {
  need ssh-keygen
  mkdir -p "$SECRET"
  if [ ! -f "$CLIENT" ]; then ssh-keygen -q -t ed25519 -N '' -f "$CLIENT"; fi
  if [ ! -f "$HOSTKEY" ]; then ssh-keygen -q -t ed25519 -N '' -f "$HOSTKEY"; fi
  # Local VM console recovery: random per-sandbox credential, not an SSH password.
  if [ ! -f "$SECRET/console-password" ]; then rand_hex 16 > "$SECRET/console-password"; fi
  if [ ! -f "$SECRET/forgejo-password" ]; then rand_hex 24 > "$SECRET/forgejo-password"; fi
  if [ ! -f "$SECRET/forgejo-secret" ]; then rand_hex 32 > "$SECRET/forgejo-secret"; fi
  if [ ! -f "$SECRET/forgejo-internal-token" ]; then rand_hex 24 > "$SECRET/forgejo-internal-token"; fi
  chmod 700 "$SECRET"
  chmod 600 "$CLIENT" "$HOSTKEY" "$SECRET/console-password" "$SECRET/forgejo-password" "$SECRET/forgejo-secret" "$SECRET/forgejo-internal-token"
  # A known_hosts entry is pinned to our generated guest host key, not TOFU.
  awk -v p="[127.0.0.1]:$SSH_PORT" '{print p, $1, $2}' "$HOSTKEY.pub" | write_if_changed "$KNOWN"
  chmod 600 "$KNOWN"
}
# A single-generation file is safe to update; each instance has its own seed.
render_network() {
  cat <<EOF_NETWORK
version: 2
ethernets:
  eth0:
    match:
      macaddress: "$MAC"
    set-name: eth0
    dhcp4: true
    dhcp6: false
EOF_NETWORK
}
render_meta() { printf 'instance-id: firebreak-%s\nlocal-hostname: firebreak-%s\n' "$NAME" "$NAME"; }

# Preserve the exact original firmware version and machine version on Apple Silicon.
image_name() { printf 'generic_alpine-%s-aarch64-uefi-cloudinit-%s.qcow2' "$ALPINE_VERSION" "$ALPINE_REVISION"; }
image_url() { series=$(printf '%s' "$ALPINE_VERSION" | awk -F. '{print "v" $1 "." $2}'); printf '%s/%s/releases/cloud/%s' "${ALPINE_MIRROR%/}" "$series" "$(image_name)"; }
require_host() {
  [ "$(uname -s)" = Darwin ] || die 'VM commands require macOS; config generation and tests also work on Linux'
  case $(uname -m) in arm64|aarch64) :;; *) die 'Only Apple Silicon supported in this release';; esac
  need qemu-system-aarch64 qemu
  need qemu-img qemu
  need ssh
  need socat
}

usage() {
  cat <<'EOF_USAGE'
Firebreak 0.3: isolated Alpine/aarch64 VM for macOS
  firebreak config init [--install-deps]
  firebreak config update [--refresh-image]
  firebreak sandbox create [--storage=ephemeral|persistent] [--no-boot]
  firebreak sandbox unsafe                      # VM maintenance shell; Squid filtered
  firebreak sandbox debug                       # VM serial console + host logs, no SSH prerequisite
  firebreak sandbox console-password            # Show guest alpine console password locally
  firebreak sandbox logs [--follow]             # View host-captured serial output
  firebreak sandbox up                          # restricted VM + local Docker socket
  firebreak sandbox sh [shell-command ...]       # host shell with DOCKER_HOST
  firebreak sandbox push [--history=snapshot|shallow|full] [--depth=N]
  firebreak sandbox pull                         # create host review branch
  firebreak sandbox snapshot NAME create|restore|delete
  firebreak sandbox snapshot --list
  firebreak sandbox delete
  firebreak sandbox doctor
  firebreak --self-test | --list | --version | --help

  'sandbox' is a name, not a literal keyword. Examples:
  firebreak demo create && firebreak demo up
  firebreak demo snapshot ready create
  Sandbox names are explicit; VM boot requires Apple Silicon macOS.
EOF_USAGE
}
  # firebreak config proxy-check [--online]        # Proxy syntax/startup; optional gVisor fetch probe
  # firebreak sandbox provision                   # Resume/finish existing guest provisioning
  # firebreak sandbox repair                      # Alias: provision (keeps an existing VM disk)

# A standalone, repeatable guest bootstrap. The exact same bytes are embedded
# in cloud-init and retained on the host for SSH repair after a failed first boot.
render_gvisor_install() {
  cat <<'EOF_GVISOR'
#!/bin/sh
set -eu
umask 077
ARCH=$(uname -m)
URL=https://storage.googleapis.com/gvisor/releases/release/latest/${ARCH}
PROXY=http://10.0.2.100:3128
WORK=$(mktemp -d /tmp/firebreak-gvisor.XXXXXX)
trap 'rm -rf "$WORK"' EXIT HUP INT TERM
cd "$WORK"
# apk installed curl in the preceding packages script. Explicit proxy and
# --fail/--show-error expose Squid HTTP denials instead of BusyBox wget's
# unhelpful "error getting response". No direct-network fallback is allowed.
command -v curl >/dev/null 2>&1 || { echo 'gVisor: curl missing; packages stage failed' >&2; exit 1; }
for file in gvisor.tar.bz2 gvisor.tar.bz2.sha512; do
  echo "gVisor: downloading $file via setup proxy" >&2
  curl --fail --show-error --silent --location \
    --retry 3 --retry-delay 2 --connect-timeout 20 --max-time 900 \
    --proxy "$PROXY" --noproxy '' --output "$file" "$URL/$file" || {
      echo "gVisor: download failed for $URL/$file; inspect host .devcontainer/firebreak/proxy/access.log" >&2
      exit 1
    }
done
sha512sum -c gvisor.tar.bz2.sha512
# Do not install unverified downloads, and keep failed ones out of /usr/local/bin.
tar -xf gvisor.tar.bz2 -C /usr/local/bin
chmod a+rx -R /usr/local/bin/runsc \
  /usr/local/bin/containerd-shim-runsc-v1 \
  /usr/local/bin/gvisor-bin/
/usr/local/bin/runsc install
# Idempotent on explicit repair and on subsequent boots.
for setting in 'user.max_user_namespaces=7182' 'kernel.yama.ptrace_scope=0' 'kernel.watchdog_thresh=30'; do
  grep -Fxq "$setting" /etc/sysctl.conf || printf '%s\n' "$setting" >> /etc/sysctl.conf
done
echo 'gVisor: bootstrap completed' >&2
EOF_GVISOR
}

render_seed() {
  vm_paths "$1"
  ensure_dirs
  ensure_keys
  SANDBOX_STORAGE=$STORAGE
  if [ -f "$SECRET/storage" ]; then SANDBOX_STORAGE=$(cat "$SECRET/storage"); fi
  case $SANDBOX_STORAGE in ephemeral|persistent) :;; *) die "Invalid saved storage mode";; esac
  MAC=$(mac_from_string "$VERSION-$BUILD-$NAME")
  mkdir -p "$SEED"
  render_network | write_if_changed "$SEED/network-config"
  render_meta | write_if_changed "$SEED/meta-data"
  # Scripts deliberately live in cloud-init's per-instance directory: the image's
  # NoCloud datasource is only trusted to seed initial state. Reconciliation is SSH.
  # The first-boot apk install runs *with* a proxy because package modules do not
  # reliably inherit HTTP_PROXY across Alpine's OpenRC cloud-init stages.
  {
    cat <<'EOF_CLOUD'
#cloud-config
hostname: firebreak
manage_etc_hosts: true
ssh_pwauth: false
ssh:
  emit_keys_to_console: false
disable_root: false
users:
  - name: root
    passwd: "*"
    lock_passwd: false
    ssh_authorized_keys:
EOF_CLOUD
    printf '      - %s\n' "$(cat "$CLIENT.pub")"
    cat <<'EOF_CLOUD'
  - name: alpine
    uid: 1000
    groups: wheel
    shell: /bin/ash
    lock_passwd: false
# Local video/serial console only: SSH password authentication stays disabled.
chpasswd:
  expire: false
  users:
    - name: alpine
      type: text
EOF_CLOUD
    printf '      password: "%s"\n' "$(cat "$SECRET/console-password")"
    cat <<'EOF_CLOUD'
ssh_keys:
  ed25519_private: |
EOF_CLOUD
    while IFS= read -r line || [ -n "$line" ]; do printf '    %s\n' "$line"; done < "$HOSTKEY"
    printf '  ed25519_public: %s\n' "$(cat "$HOSTKEY.pub")"
    cat <<'EOF_CLOUD'
package_update: false
package_upgrade: false
growpart:
  mode: auto
  devices: ['/']
resize_rootfs: true
mounts:
  - ['shared', '/mnt/shared', '9p', 'trans=virtio,version=9p2000.L,ro', '0', '0']
write_files:
  - path: /var/lib/cloud/scripts/per-instance/05-firebreak-packages.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      export HTTP_PROXY=http://10.0.2.100:3128
      export HTTPS_PROXY=$HTTP_PROXY
      export http_proxy=$HTTP_PROXY
      export https_proxy=$HTTP_PROXY
      # Ensure community is present for Forgejo and its OpenRC service.
EOF_CLOUD
    printf '      grep -Fqx %s /etc/apk/repositories || printf %s >> /etc/apk/repositories\n' \
      "'${ALPINE_MIRROR%/}/v$(printf %s "$ALPINE_VERSION" | cut -d. -f1-2)/community'" \
      "'${ALPINE_MIRROR%/}/v$(printf %s "$ALPINE_VERSION" | cut -d. -f1-2)/community\\n'"
    printf '      apk update\n      apk add podman podman-compose git curl iptables qemu-guest-agent crun %s %s-openrc\n' "$FORGEJO_PACKAGE" "$FORGEJO_PACKAGE"
    cat <<'EOF_CLOUD'
  - path: /var/lib/cloud/scripts/per-instance/10-firebreak-ssh.sh
    permissions: '0755'
    content: |
EOF_CLOUD
    # The same script is available as ssh-recovery.sh on the read-only seed.
    render_ssh_recovery | sed 's/^/      /'
    cat <<'EOF_CLOUD'
  - path: /var/lib/cloud/scripts/per-instance/12-firebreak-gvisor.sh
    permissions: '0755'
    content: |
EOF_CLOUD
    # This is the *same* script used by first boot and by 'sandbox repair'.
    # Generating it once avoids having an outdated script embedded in NoCloud.
    render_gvisor_install | sed 's/^/      /'
    cat <<'EOF_CLOUD'
  - path: /var/lib/cloud/scripts/per-instance/20-firebreak-services.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      mkdir -p /etc/containers/containers.conf.d
      grep -q '^rc_cgroup_mode="unified"$' /etc/rc.conf || echo 'rc_cgroup_mode="unified"' >> /etc/rc.conf
      grep -q '^rc_cgroup_controllers=' /etc/rc.conf || echo 'rc_cgroup_controllers="cpuset cpu io memory hugetlb pids"' >> /etc/rc.conf
      rc-update add cgroups sysinit || true
      rc-service cgroups start || true
      # Podman service starts after host-selected runtime is applied over SSH.
      rc-update del podman default 2>/dev/null || :
      rc-update add qemu-guest-agent default
      rc-service qemu-guest-agent start || true
final_message: 'Firebreak NoCloud seed complete'
EOF_CLOUD
  } | write_if_changed "$SEED/user-data"
  chmod 600 "$SEED/user-data" "$SEED/network-config" "$SEED/meta-data"
  render_ssh_recovery | write_if_changed "$SEED/ssh-recovery.sh"
  chmod 600 "$SEED/ssh-recovery.sh"
  render_gvisor_install | write_if_changed "$SEED/gvisor-install.sh"
  chmod 600 "$SEED/gvisor-install.sh"
  render_guest_apply | write_if_changed "$SEED/reconcile.sh"
  chmod 600 "$SEED/reconcile.sh"
}


# Emergency SSH repair is written both to the NoCloud seed disk (for an
# already-created guest) and to the per-instance first-boot script. This path
# deliberately does not require host->guest SSH or cloud-init reruns.
render_ssh_recovery() {
  cat <<'EOF_SSH_RECOVER'
#!/bin/sh
set -eu
umask 077
# Alpine may not read sshd_config.d unless the main config includes it.
# OpenSSH uses the first value for each global directive, so include Firebreak
# policy BEFORE any preexisting settings in the main configuration.
mkdir -p /root/.ssh /etc/ssh/sshd_config.d
chmod 700 /root /root/.ssh
if [ ! -f /root/.ssh/authorized_keys ]; then
  : > /root/.ssh/authorized_keys
fi
EOF_SSH_RECOVER
  printf "if ! grep -Fqx '%s' /root/.ssh/authorized_keys; then\n" "$(cat "$CLIENT.pub")"
  printf "  printf '%%s\\\\n' '%s' >> /root/.ssh/authorized_keys\n" "$(cat "$CLIENT.pub")"
  printf 'fi\n'
  cat <<'EOF_SSH_RECOVER'
chmod 600 /root/.ssh/authorized_keys
cat > /etc/ssh/sshd_config.d/00-firebreak.conf <<'EOF'
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
AllowTcpForwarding yes
AllowStreamLocalForwarding yes
EOF
chmod 600 /etc/ssh/sshd_config.d/00-firebreak.conf
# Include must be the FIRST directive to avoid earlier settings winning.
config=/etc/ssh/sshd_config
first_line=$(sed -n '1p' "$config")
if [ "$first_line" != 'Include /etc/ssh/sshd_config.d/*.conf' ]; then
  tmp=$(mktemp /etc/ssh/sshd_config.firebreak.XXXXXX)
  {
    printf 'Include /etc/ssh/sshd_config.d/*.conf\n'
    cat "$config"
  } > "$tmp"
  chmod 600 "$tmp"
  if ! /usr/sbin/sshd -t -f "$tmp"; then
    rm -f "$tmp"
    echo 'Firebreak SSH recovery: proposed config is invalid; main config unchanged' >&2
    exit 1
  fi
  cp -p "$config" /etc/ssh/sshd_config.firebreak-backup
  mv -f "$tmp" "$config"
fi
/usr/sbin/sshd -t
# Verify *effective* daemon settings; merely writing a snippet is insufficient.
policy=$(/usr/sbin/sshd -T -C user=root,host=localhost,addr=10.0.2.2)
for required in 'permitrootlogin prohibit-password' \
                'passwordauthentication no' \
                'pubkeyauthentication yes' \
                'authorizedkeysfile .ssh/authorized_keys'; do
  if ! printf '%s\n' "$policy" | grep -Fxq "$required"; then
    echo "Firebreak SSH recovery: effective sshd policy missing: $required" >&2
    exit 1
  fi
done
rc-service sshd restart
