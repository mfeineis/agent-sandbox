fetch_image() {
  require curl
  require gpg gnupg
  require qemu-img qemu

  ensure_dirs
  write_alpine_key

  BASE=$IMAGES/$(image_name)
  URL=$(image_url)
  if [ ! -f "$BASE" ]; then
    info "Downloading signed Alpine image: $URL"
    curl --fail --location --proto '=https' --tlsv1.2 --output "$BASE.part" "$URL" || panic $EX_IOERR 'Alpine image download failed'
    mv -f "$BASE.part" "$BASE"
  fi
  if [ ! -f "$BASE.asc" ]; then
    curl --fail --location --proto '=https' --tlsv1.2 --output "$BASE.asc.part" "$URL.asc" || panic $EX_IOERR 'Alpine signature download failed'
    mv -f "$BASE.asc.part" "$BASE.asc"
  fi
  verify_gpg_signature "$ALPINE_FPR" "$IMAGES/alpine-key.asc" "$BASE.asc" "$BASE"
}

fetch_firmware() {
  FIRMWARE=$IMAGES/$FIRMWARE_VERSION-QEMU_EFI.fd
  if [ ! -f "$FIRMWARE" ] || ! printf '%s  %s\n' "$FIRMWARE_SHA256" "$FIRMWARE" | shasum -a 256 -c >/dev/null 2>&1; then
    require curl
    curl --fail --location --proto '=https' --tlsv1.2 --output "$FIRMWARE.part" "$FIRMWARE_URL" || panic $EX_IOERR 'Firmware download failed'
    printf '%s  %s\n' "$FIRMWARE_SHA256" "$FIRMWARE.part" | shasum -a 256 -c >/dev/null 2>&1 || panic $EX_CONFIG 'Firmware digest mismatch'
    mv -f "$FIRMWARE.part" "$FIRMWARE"
  fi
}

# One implementation for both modes. All egress is DENIED by QEMU unless
# explicitly forwarded. The guest sees only its internal QEMU user network.
net_args() {
  profile=$1
  NET="user,id=net0,restrict=on,ipv6=off,net=10.0.2.0/24,dhcpstart=10.0.2.15,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22"
  NET="$NET,guestfwd=tcp:10.0.2.100:11434-cmd:socat STDIO TCP:127.0.0.1:11434"
  case $profile in
    unsafe) NET="$NET,guestfwd=tcp:10.0.2.100:3128-cmd:socat STDIO TCP:127.0.0.1:$SQUID_PORT" ;;
    models) NET="$NET,guestfwd=tcp:10.0.2.100:3128-cmd:socat STDIO TCP:127.0.0.1:$SQUID_MODELS_PORT" ;;
    offline) : ;;
    *) panic $EX_SOFTWARE "Unknown network policy: $profile" ;;
  esac
  printf '%s\n' "$NET"
}

# never exec; caller supervises it and holds a disk lock
qemu_vm() {
  disk=$1
  seed=$2
  mac=$3
  mode=$4
  serial_mode=${5:-log}

  net=$(net_args "$mode")
  set -- qemu-system-aarch64 \
    -machine virt-11.0 -cpu host -accel hvf \
    -bios "$FIRMWARE" \
    -name "firebreak-$NAME" \
    -m "$VM_MEMORY" -smp "$VM_CPUS" \
    -object iothread,id=io_os \
    -device virtio-scsi-pci,id=scsi_os,iothread=io_os,num_queues=1 \
    -blockdev "driver=file,node-name=osfile,filename=$disk,aio=threads" \
    -blockdev 'driver=qcow2,node-name=osdisk,file=osfile,read-only=off' \
    -device scsi-hd,drive=osdisk,bus=scsi_os.0,channel=0,scsi-id=0,lun=0,bootindex=1 \
    -blockdev "driver=vvfat,node-name=cidata,dir=$seed,label=CIDATA,read-only=on" \
    -device scsi-hd,drive=cidata,bus=scsi_os.0,channel=0,scsi-id=1,lun=0 \
    -netdev "$net" \
    -device "virtio-net-pci,netdev=net0,mac=$mac" \
    -chardev "socket,path=$TMP/$NAME.qga.sock,server=on,wait=off,id=qga0" \
    -device virtio-serial-pci \
    -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0 \
    -device qemu-xhci -device usb-kbd -device usb-tablet \
    -k en-us
  if [ "$DISPLAY_ENABLED" = 1 ]; then
    set -- "$@" -device virtio-gpu-pci
  fi
  if [ "$SHARE_ENABLED" = 1 ]; then
    set -- "$@" -fsdev "local,id=shared,path=$SHARED,security_model=mapped-xattr,readonly=on" \
      -device virtio-9p-pci,fsdev=shared,mount_tag=shared
  fi
  # QEMU logs guest UART bytes directly: no cloud-init, SSH, or extra tool needed.
  # In debug mode, stdio is interactive *and* copied to the same log file.
  case $serial_mode in
    log) set -- "$@" -chardev "file,id=fbserial,path=$SERIAL_LOG" -serial chardev:fbserial ;;
    interactive) set -- "$@" -chardev "stdio,id=fbserial,signal=on,logfile=$SERIAL_LOG,logappend=on" -serial chardev:fbserial ;;
    *) panic $EX_SOFTWARE "Unknown serial mode: $serial_mode" ;;
  esac
  exec "$@"
}

ssh_vm() {
  ssh -p "$SSH_PORT" -l root -i "$CLIENT" \
    -o "UserKnownHostsFile=$KNOWN" -o StrictHostKeyChecking=yes \
    -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=4 \
    127.0.0.1 "$@"
}

wait_ssh() {
  attempts=0
  SSH_WAIT_LOG=$TMP/$NAME.ssh-wait.log
  info 'Waiting for SSH (max 4 minutes; boot serial and SSH errors are logged)...'
  while [ "$attempts" -lt 120 ]; do
    if ssh_vm 'true' </dev/null >/dev/null 2> "$SSH_WAIT_LOG"; then
      info 'SSH is ready.'
      return 0
    fi
    if ! kill -0 "$VM_PID" 2>/dev/null; then boot_diagnostics; panic $EX_SOFTWARE 'QEMU exited before SSH was ready'; fi
    attempts=$((attempts + 1))
    if [ $((attempts % 10)) -eq 0 ]; then
      info "SSH still unavailable after $((attempts * 2))s; last SSH error:"
      tail -n 2 "$SSH_WAIT_LOG" >&2 || :
    fi
    sleep 2
  done
  boot_diagnostics
  tail -n 10 "$SSH_WAIT_LOG" >&2 || :
  panic $EX_NOINPUT "Timed out waiting for guest SSH; inspect $SSH_WAIT_LOG, or run '$0 $NAME debug'"
}

# Cloud-init's *historical* error state is not the same as guest readiness:
# an interrupted per-instance installer may have been repaired afterward.
# Only a terminal cloud-init state allows reconciliation to begin. A terminal
# error remains visible, but is not an irreversible provisioning dead-end.
wait_cloud() {
  CLOUD_STATE=unknown
  attempts=0
  info 'Waiting for cloud-init to reach a terminal state (max 8 minutes)...'
  while [ "$attempts" -lt 240 ]; do
    result=$(ssh_vm 'cloud-init status 2>&1 || true' </dev/null 2>/dev/null) || result='SSH unavailable'
    case $result in
      *'status: done'*) CLOUD_STATE="done"; info 'Cloud-init completed.'; return 0 ;;
      *'status: error'*|*'status: degraded'*)
        CLOUD_STATE=error
        CLOUD_LOG=$TMP/$NAME.cloud-init-status.log
        ssh_vm 'cloud-init status --long 2>&1 || :; tail -n 70 /var/log/cloud-init-output.log 2>/dev/null || :' \
          </dev/null > "$CLOUD_LOG" 2>&1 || :
        warn "cloud-init reported a prior failure; details: $CLOUD_LOG"
        info 'Firebreak will verify the installed components and reconcile if safe.'
        tail -n 15 "$CLOUD_LOG" >&2 || :
        return 0;;
      *'status: disabled'*) boot_diagnostics; panic $EX_SOFTWARE 'Cloud-init is disabled in the guest' ;;
    esac
    if ! kill -0 "$VM_PID" 2>/dev/null; then boot_diagnostics; panic $EX_SOFTWARE 'QEMU stopped before cloud-init completed'; fi
    attempts=$((attempts + 1))
    if [ $((attempts % 10)) -eq 0 ]; then
      info "Cloud-init still running after $((attempts * 2))s: $result"
    fi
    sleep 2
  done
  boot_diagnostics
  panic $EX_UNAVAILABLE "Timed out waiting for cloud-init (last response: $result); run '$0 $NAME debug'"
}

SQUID_PID=
start_squid() {
  SQUID_BIN=$(resolve_squid)
  render_proxy_config
  # Keep parser errors: Squid can fail even when the generated syntax is valid
  # (permissions, missing paths, incompatible Squid major version, etc.).
  if ! ( cd "$PROXY" && "$SQUID_BIN" -k parse -f "$PROXY/squid.conf" ) > "$PROXY/parse.log" 2>&1; then
    warn "Squid policy validation failed ($SQUID_BIN):"
    tail -n 30 "$PROXY/parse.log" >&2 || :
    panic $EX_CONFIG "Inspect $PROXY/parse.log"
  fi
  ( cd "$PROXY" && exec "$SQUID_BIN" -N -f "$PROXY/squid.conf" ) > "$PROXY/foreground.log" 2>&1 &
  SQUID_PID=$!
  sleep 2
  if ! kill -0 "$SQUID_PID" 2>/dev/null; then
    # Reap the process and show the actual reason instead of a generic error.
    wait "$SQUID_PID" 2>/dev/null || :
    SQUID_PID=
    warn "Squid startup failed ($SQUID_BIN):"
    tail -n 30 "$PROXY/foreground.log" >&2 || :
    panic $EX_UNAVAILABLE "Inspect $PROXY/foreground.log"
  fi
}

VM_PID=
TUNNEL_PID=
VM_LOCK=
SERIAL_LOG=
VM_LOG=
boot_diagnostics() {
  info "Serial console log: $SERIAL_LOG"
  info "QEMU diagnostics: $VM_LOG"
  if [ -f "$SERIAL_LOG" ]; then
    info '--- Last 50 lines of guest serial output ---'
    tail -n 50 "$SERIAL_LOG" >&2 || :
  fi
  if [ -s "$VM_LOG" ]; then
    info '--- QEMU stdout/stderr ---'
    tail -n 25 "$VM_LOG" >&2 || :
  fi
  info "Recovery: '$CLI_NAME $NAME debug', '$CLI_NAME $NAME logs'"
}

cleanup_vm() {
  exit_code=$?
  trap - EXIT HUP INT TERM
  ## # Remove only our own Buildx daemon before stopping the socket tunnel.
  ## cleanup_firebreak_builder || :
  if [ -n "$TUNNEL_PID" ]; then kill "$TUNNEL_PID" 2>/dev/null || :; wait "$TUNNEL_PID" 2>/dev/null || :; fi
  if [ -n "$VM_PID" ] && kill -0 "$VM_PID" 2>/dev/null; then
    ssh_vm '/sbin/poweroff' </dev/null >/dev/null 2>&1 || :
    waiting=0
    while kill -0 "$VM_PID" 2>/dev/null && [ "$waiting" -lt 30 ]; do sleep 1; waiting=$((waiting+1)); done
    if kill -0 "$VM_PID" 2>/dev/null; then
      warn 'Warning: QEMU did not shut down normally; attempting SIGTERM'
      kill "$VM_PID" 2>/dev/null || :
      sleep 3
      if kill -0 "$VM_PID" 2>/dev/null; then kill -KILL "$VM_PID" 2>/dev/null || :; fi
    fi
  fi
  [ -z "$VM_PID" ] || wait "$VM_PID" 2>/dev/null || :
  [ -z "$SQUID_PID" ] || { kill "$SQUID_PID" 2>/dev/null || :; wait "$SQUID_PID" 2>/dev/null || :; }
  [ -z "$VM_LOCK" ] || rmdir "$VM_LOCK" 2>/dev/null || :
  rm -f "$VM_SOCKET" "$ACTIVE_MODE"
  exit "$exit_code"
}

lock_disk() {
  VM_LOCK=$DISK.lock
  mkdir "$VM_LOCK" 2>/dev/null || panic $EX_SOFTWARE "Sandbox disk locked: $VM_LOCK (clear a stale lock only after verifying the VM is off)"
}

start_vm() {
  profile=$1
  serial_mode=${2:-log}

  case $serial_mode in
    log|interactive) : ;;
    *) panic $EX_SOFTWARE 'Invalid serial mode' ;;
  esac
  if [ "$serial_mode" = interactive ] && [ ! -t 0 ]; then
    panic $EX_OSERR 'Debug console needs a real terminal (stdin must be a TTY)'
  fi
  [ -f "$DISK" ] || panic $EX_DATAERR "No sandbox named $NAME; run '$CLI_NAME $NAME new'"
  require_host
  [ ! -d "$DISK.lock" ] || panic $EX_USAGE 'Sandbox is already running'
  render_seed "$NAME"
  fetch_firmware
  lock_disk
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  trap cleanup_vm EXIT
  # The launch profile is the authority for the host-side Docker client policy.
  # cmd_shell_env reads it only while the forwarded Podman socket exists.
  printf '%s\n' "$profile" | write_if_changed "$ACTIVE_MODE"
  case $profile in
    unsafe|models) start_squid ;;
  esac
  SERIAL_LOG=$TMP/$NAME.serial.log
  VM_LOG=$TMP/$NAME.qemu.log
  # Log every boot from the start, even if cloud-init/sshd never run.
  : > "$SERIAL_LOG"; : > "$VM_LOG"
  chmod 600 "$SERIAL_LOG" "$VM_LOG"
  if [ "$serial_mode" = "interactive" ]; then
    qemu_vm "$DISK" "$SEED" "$MAC" "$profile" interactive < /dev/tty 2>> "$VM_LOG" &
  else
    qemu_vm "$DISK" "$SEED" "$MAC" "$profile" log >> "$VM_LOG" 2>&1 &
  fi
  VM_PID=$!
  info "Starting $NAME ($profile, guest MAC $MAC)..."
  info "Serial log: $SERIAL_LOG"
  [ "$serial_mode" = "interactive" ] || wait_ssh
}

# Test the actual guest capabilities, rather than trusting cloud-init's cached
# final status or whether one installer happened to return successfully.
check_guest_packages() {
  ssh_vm '/bin/sh -s' <<'EOF_CHECK_PACKAGES'
set -eu
for cmd in curl git podman forgejo rc-service; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "Missing guest command: $cmd" >&2; exit 1; }
done
EOF_CHECK_PACKAGES
}

check_gvisor() {
  ssh_vm 'test -x /usr/local/bin/runsc && test -d /usr/local/bin/gvisor-bin' </dev/null >/dev/null 2>&1
}

install_gvisor_if_missing() {
  if check_gvisor; then
    info 'gVisor already installed; keeping existing binaries.'
    return 0
  fi
  [ -f "$SEED/gvisor-install.sh" ] || panic $EX_UNAVAILABLE 'Generated gVisor installer missing; run config update'
  GVISOR_LOG=$TMP/$NAME.gvisor-repair.log
  info 'gVisor incomplete; resuming its bootstrap through restricted setup proxy...'
  if ssh_vm '/bin/sh -s' < "$SEED/gvisor-install.sh" > "$GVISOR_LOG" 2>&1; then
    info 'gVisor bootstrap completed.'
  else
    warn 'gVisor bootstrap failed; relevant output:'
    tail -n 45 "$GVISOR_LOG" >&2 || :
    warn "Inspect $GVISOR_LOG and $PROXY/access.log"
    return 1
  fi
  check_gvisor || { warn 'gVisor bootstrap returned success but runsc installation is incomplete'; return 1; }
}

apply_podman_mode() {
  case $CURRENT_PROFILE in
    unsafe|models|offline) ;;
    *) panic $EX_SOFTWARE "Unknown Podman profile: $CURRENT_PROFILE" ;;
  esac

  ssh_vm "sh -s -- '$CURRENT_PROFILE'" <<'GUEST'
set -eu

mode=$1
proxy=http://10.0.2.100:3128
dest=/etc/containers/containers.conf.d/zz-firebreak-mode.conf
marker=/etc/firebreak/podman-mode-hash

mkdir -p /etc/containers/containers.conf.d /etc/firebreak
tmp=$(mktemp "${dest}.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM

case $mode in
  unsafe)
    pull=missing
    engine_proxy=yes
    container_proxy=yes
  ;;
  models)
    pull=never
    engine_proxy=no
    container_proxy=yes
  ;;
  offline)
    pull=never
    engine_proxy=no
    container_proxy=no
  ;;
esac

{
  printf '[engine]\npull_policy = "%s"\n' "$pull"

  if [ "$engine_proxy" = yes ]; then
    printf 'env = ["HTTP_PROXY=%s", "HTTPS_PROXY=%s", "http_proxy=%s", "https_proxy=%s"]\n' \
      "$proxy" "$proxy" "$proxy" "$proxy"
  else
    printf 'env = []\n'
  fi

  printf '\n[containers]\nhttp_proxy = false\n'

  if [ "$container_proxy" = yes ]; then
    printf 'env = ["HTTP_PROXY=%s", "HTTPS_PROXY=%s", "http_proxy=%s", "https_proxy=%s"]\n' \
      "$proxy" "$proxy" "$proxy" "$proxy"
  else
    printf 'env = []\n'
  fi
} > "$tmp"

changed=no
if ! cmp -s "$tmp" "$dest"; then
  mv -f "$tmp" "$dest"
  changed=yes
fi

wanted=$(sha256sum "$dest" | awk '{print $1}')
applied=$(cat "$marker" 2>/dev/null || true)

if ! rc-service podman status >/dev/null 2>&1; then
  rc-service podman start
elif [ "$changed" = yes ] || [ "$wanted" != "$applied" ]; then
  rc-service podman restart
fi

printf '%s\n' "$wanted" > "$marker"
GUEST
}

apply_guest() {
  # Keep stdout/stderr on the host: otherwise remote reconciliation failures
  # are indistinguishable from an SSH disconnect (and set -e hides context).
  APPLY_LOG=$TMP/$NAME.apply.log
  selected_runtime=$(runtime_for_profile "$CURRENT_PROFILE")
  info "Applying Firebreak guest policy (profile=$CURRENT_PROFILE, OCI runtime=$selected_runtime; log: $APPLY_LOG)..."
  if ssh_vm "/bin/sh -s -- '$CURRENT_PROFILE' '$selected_runtime'" < "$SEED/reconcile.sh" > "$APPLY_LOG" 2>&1; then
    info 'Guest policy script completed.'
  else
    warn 'Guest policy script failed; last 60 lines follow:'
    tail -n 60 "$APPLY_LOG" >&2 || :
    panic $EX_SOFTWARE "Guest reconciliation failed; see $APPLY_LOG (disk preserved)"
  fi
  # Interactive guest login shells inherit the proxy through /etc/profile.d.
  # The active listener in both guest-forwarded modes is 10.0.2.100:3128.
  case $CURRENT_PROFILE in
    unsafe|models)
      ssh_vm "printf '%s\\n' 'export HTTP_PROXY=http://10.0.2.100:3128' 'export HTTPS_PROXY=\$HTTP_PROXY' 'export http_proxy=\$HTTP_PROXY' 'export https_proxy=\$HTTP_PROXY' > /etc/profile.d/firebreak-proxy.sh" || \
        panic $EX_PROTOCOL 'Guest proxy profile installation failed'
    ;;
    offline)
      ssh_vm 'rm -f /etc/profile.d/firebreak-proxy.sh' || panic $EX_PROTOCOL 'Could not clear guest proxy profile'
    ;;
    *) panic $EX_SOFTWARE "Unexpected profile in apply_guest: $CURRENT_PROFILE" ;;
  esac
  apply_podman_mode || panic $EX_PROTOCOL 'Could not apply Podman network policy'
}

verify_guest() {
  # These are the minimum capabilities needed for a usable Firebreak VM.
  # Incomplete cloud-init must not be masked by touching 'provisioned'.
  VERIFY_LOG=$TMP/$NAME.verify.log
  if ssh_vm '/bin/sh -s' > "$VERIFY_LOG" 2>&1 <<'EOF_VERIFY'
set -eu
for cmd in git curl podman forgejo; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "Missing required command: $cmd" >&2; exit 1; }
done
test -x /usr/local/bin/runsc || { echo 'Missing gVisor runsc' >&2; exit 1; }
test -x /usr/local/bin/runsc-custom || { echo 'Missing Firebreak runtime policy' >&2; exit 1; }
test -s /etc/forgejo/app.ini || { echo 'Missing Forgejo configuration' >&2; exit 1; }
rc-service podman status || { echo 'Podman service not running' >&2; exit 1; }
rc-service forgejo status || { echo 'Forgejo service not running' >&2; exit 1; }
EOF_VERIFY
  then
    case $CURRENT_PROFILE in
      unsafe|models) ssh_vm 'test -s /etc/profile.d/firebreak-proxy.sh' </dev/null >> "$VERIFY_LOG" 2>&1 || { info 'Guest proxy profile missing'; return 1; } ;;
      offline) : ;;
    esac
    return 0
  fi
  info 'Guest readiness verification failed:'
  tail -n 40 "$VERIFY_LOG" >&2 || :
  return 1
}

finish_provisioning() {
  # An existing disk may have a historical cloud-init error from a now-fixed
  # bootstrap. Wait for it to *stop running*, then verify and reconcile.
  wait_cloud
  if ! check_guest_packages; then
    panic $EX_UNAVAILABLE "Guest packages are incomplete; use '$CLI_NAME $NAME unsafe' to inspect /var/log/cloud-init-output.log"
  fi
  install_gvisor_if_missing || panic $EX_TEMPFAIL 'gVisor is not ready; VM disk preserved'
  apply_guest
  verify_guest || panic $EX_TEMPFAIL "Guest policy applied but services are not ready; inspect $TMP/$NAME.verify.log"
  touch "$SECRET/provisioned"
  if [ "$CLOUD_STATE" = "error" ]; then
    info "Provisioned $NAME after verification; historical cloud-init error retained in $TMP/$NAME.cloud-init-status.log."
  else
    info "Provisioned $NAME; guest components and services verified."
  fi
}

cmd_vm_new() {
  mode=$STORAGE
  boot=yes
  for opt do
    case $opt in
      --storage=*) mode=${opt#*=} ;;
      --no-boot) boot=no ;;
      *) panic $EX_USAGE "Unknown create option: $opt" ;;
    esac
  done
  case $mode in
    ephemeral|persistent) : ;;
    *) panic $EX_USAGE 'Choose --storage=ephemeral|persistent' ;;
  esac
  require_host
  configure_vm_paths "$NAME"
  if [ -f "$DISK" ]; then
    panic $EX_USAGE "Disk already exists: $DISK (use $0 $NAME provision to resume; never overwritten)"
  fi
  ensure_dirs
  ensure_keys
  printf '%s\n' "$mode" > "$SECRET/storage"
  render_seed "$NAME"
  fetch_image
  fetch_firmware
  # No partial final disk: create, resize, and snapshot a temporary QCOW2.
  part=$DISK.creating.$$
  trap 'rm -f "$part"' EXIT HUP INT TERM
  qemu-img convert -O qcow2 "$BASE" "$part" || panic $EX_CANTCREAT 'Could not create QCOW2'
  qemu-img resize "$part" "$VM_SIZE" || panic $EX_CANTCREAT 'Could not resize QCOW2'
  qemu-img snapshot -c base "$part" || panic $EX_CANTCREAT 'Could not snapshot initial disk'
  mv "$part" "$DISK"
  trap - EXIT HUP INT TERM
  info "Created $NAME, storage=$mode ($DISK)"
  if [ "$boot" = yes ]; then
    CURRENT_PROFILE=unsafe
    start_vm unsafe
    finish_provisioning
    info 'Initial provisioning complete; shutting down VM.'
    # EXIT trap requests a graceful shutdown.
  else
    info 'Disk created but not provisioned. Its first boot still runs cloud-init.'
  fi
}

cmd_console_password() {
  [ -f "$SECRET/console-password" ] || panic $EX_USAGE 'Console password not generated; rerun config update or create'
  info "Console user: $GUEST_USER (VM video or serial console only; not SSH)"
  cat "$SECRET/console-password"
  printf '\n'
}

cmd_logs() {
  logfile=$TMP/$NAME.serial.log
  case ${1:-} in
    '') [ "$#" -eq 0 ] || panic $EX_USAGE 'logs accepts only --follow'; [ -f "$logfile" ] || panic $EX_TEMPFAIL "No boot log yet: $logfile"; cat "$logfile" ;;
    --follow) [ "$#" -eq 1 ] || panic $EX_USAGE 'logs accepts only --follow'; [ -f "$logfile" ] || panic $EX_TEMPFAIL "No boot log yet: $logfile"; exec tail -f "$logfile" ;;
    *) print_usage ;;
  esac
}

cmd_vm_debug() {
  # No SSH readiness, no cloud-init wait, no provisioning/reconciliation.
  # Restrict all guest egress through the same Squid-filtered unsafe profile.
  CURRENT_PROFILE=unsafe
  start_vm unsafe interactive
  cmd_config proxy-check --online
  info '--- Firebreak guest recovery console ---'
  info "Host serial log: $SERIAL_LOG"
  info "Host QEMU log: $VM_LOG"
  info "Login on video/serial terminal: $GUEST_USER; password via '$CLI_NAME $NAME console-password' in another terminal."
  info 'If cloud-init failed before creating the user, the password may NOT be active.'
  info "SSH recovery (inside Alpine, using doas): mkdir -p /mnt/fbseed; mount -t vfat /dev/sdb1 /mnt/fbseed; sh /mnt/fbseed/ssh-recovery.sh"
  info 'Debug mode stays running without SSH. Quit QEMU or interrupt Firebreak to stop.'
  status=0
  wait "$VM_PID" || status=$?
  VM_PID=
  [ "$status" -eq 0 ] || panic $EX_SOFTWARE "QEMU exited with status $status; inspect $VM_LOG"
}

cmd_vm_provision() {
  [ -f "$DISK" ] || panic $EX_USAGE "No existing VM disk; run '$CLI_NAME $NAME create'"
  CURRENT_PROFILE=unsafe
  start_vm unsafe
  finish_provisioning
  info "VM will shut down cleanly; then run '$CLI_NAME $NAME up'."
}

# Previous `repair` now acts as an alias for general resumable provisioning:
# reinstalling gVisor on every invocation would be unnecessary and brittle.
repair_vm() { provision_vm; }

cmd_vm_unsafe_qemu() {
  CURRENT_PROFILE=unsafe
  start_vm unsafe
  if [ ! -f "$SECRET/provisioned" ]; then
    warn "Warning: not provisioned. Maintenance only; run '$CLI_NAME $NAME provision' to finish setup."
  else
    apply_guest
  fi
  # Unsafe is deliberately manual. Never replay installers or mark an
  # unprovisioned VM ready just because a shell session was opened/closed.
  info 'Maintenance shell: network access is restricted to Squid setup allowlist.'
  status=0
  ssh -t -p "$SSH_PORT" -l root -i "$CLIENT" \
    -o "UserKnownHostsFile=$KNOWN" -o StrictHostKeyChecking=yes \
    -o IdentitiesOnly=yes 127.0.0.1 || status=$?
  if [ ! -f "$SECRET/provisioned" ]; then
    info "Still unprovisioned; run '$CLI_NAME $NAME provision' when ready to finish setup."
  fi
  return "$status"
}

cmd_vm_up() {
  [ -f "$SECRET/provisioned" ] || panic $EX_USAGE 'Not provisioned: run new (or unsafe for first boot)'
  case $NETWORK_WORK in
    offline|models) CURRENT_PROFILE=$NETWORK_WORK ;;
  esac
  start_vm "$CURRENT_PROFILE"
  apply_guest
  verify_guest || panic $EX_UNAVAILABLE "Sandbox guest services are unhealthy; inspect $TMP/$NAME.verify.log"
  rm -f "$VM_SOCKET"
  ssh -N -p "$SSH_PORT" -l root -i "$CLIENT" \
    -o "UserKnownHostsFile=$KNOWN" -o StrictHostKeyChecking=yes \
    -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes \
    -o StreamLocalBindUnlink=yes \
    -L "$VM_SOCKET:/run/podman/podman.sock" \
    -L "127.0.0.1:$FORGEJO_PORT:127.0.0.1:$FORGEJO_PORT" \
    127.0.0.1 &
  TUNNEL_PID=$!
  sleep 1
  kill -0 "$TUNNEL_PID" 2>/dev/null || panic $EX_PROTOCOL 'SSH forwarding failed'
  info "Sandbox $NAME ready. Use '$0 $NAME sh', Forgejo at http://127.0.0.1:$FORGEJO_PORT"
  wait "$TUNNEL_PID"
}

cmd_vm_unsafe() {
  [ -f "$SECRET/provisioned" ] || panic $EX_USAGE 'Not provisioned: run new (or unsafe for first boot)'
  case $NETWORK_WORK in
    offline|models) CURRENT_PROFILE=$NETWORK_WORK ;;
  esac
  CURRENT_PROFILE=unsafe
  start_vm "$CURRENT_PROFILE"
  apply_guest
  verify_guest || panic $EX_UNAVAILABLE "Sandbox guest services are unhealthy; inspect $TMP/$NAME.verify.log"
  # Unsafe is deliberately manual. Never replay installers or mark an
  # unprovisioned VM ready just because a shell session was opened/closed.
  info 'Maintenance shell: network access is restricted to Squid setup allowlist.'
  rm -f "$VM_SOCKET"
  ssh -N -p "$SSH_PORT" -l root -i "$CLIENT" \
    -o "UserKnownHostsFile=$KNOWN" -o StrictHostKeyChecking=yes \
    -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes \
    -o StreamLocalBindUnlink=yes \
    -L "$VM_SOCKET:/run/podman/podman.sock" \
    -L "127.0.0.1:$FORGEJO_PORT:127.0.0.1:$FORGEJO_PORT" \
    127.0.0.1 &
  TUNNEL_PID=$!
  sleep 1
  kill -0 "$TUNNEL_PID" 2>/dev/null || panic $EX_PROTOCOL 'SSH forwarding failed'
  info "Sandbox $NAME ready. Use '$0 $NAME sh', Forgejo at http://127.0.0.1:$FORGEJO_PORT"
  wait "$TUNNEL_PID"
}

# Docker CLI injects proxy build arguments; containers.conf alone does not
# reliably inject them into Podman builds invoked through the Docker API.
# Never use the user's global ~/.docker/config.json for Firebreak.
configure_docker_client() {
  [ -f "$ACTIVE_MODE" ] || panic $EX_SOFTWARE "Sandbox network profile unavailable: $ACTIVE_MODE"
  active_mode=$(cat "$ACTIVE_MODE") || panic $EX_SOFTWARE 'Cannot read sandbox network profile'
  case $active_mode in
    unsafe) cli_mode=unsafe ;;
    offline|models) cli_mode=work ;;
    *) panic $EX_SOFTWARE "Unexpected sandbox network profile: $active_mode" ;;
  esac
  cli_dir="$OCI_STORE/$NAME/$cli_mode"
  mkdir -p "$cli_dir"
  if [ "$cli_mode" = unsafe ]; then
    cat <<'EOF_DOCKER_PROXY' | write_if_changed "$cli_dir/config.json"
{
  "proxies": {
    "default": {
      "httpProxy": "http://10.0.2.100:3128",
      "httpsProxy": "http://10.0.2.100:3128"
    }
  }
}
EOF_DOCKER_PROXY
  else
    printf '{}\n' | write_if_changed "$cli_dir/config.json"
  fi
  # Keep Compose/Buildx available without sharing Docker credentials or auths.
  if [ -n "${HOME:-}" ] && [ -d "$HOME/.docker/cli-plugins" ] && \
     [ ! -e "$cli_dir/cli-plugins" ] && [ ! -L "$cli_dir/cli-plugins" ]; then
    ln -s "$HOME/.docker/cli-plugins" "$cli_dir/cli-plugins"
  fi
  export DOCKER_CONFIG="$cli_dir"
}

