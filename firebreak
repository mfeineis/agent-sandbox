unsafe_qemu_vm() {
  CURRENT_PROFILE=unsafe
  start_vm unsafe
  if [ ! -f "$SECRET/provisioned" ]; then
    say "Warning: not provisioned. Maintenance only; run '$0 $NAME provision' to finish setup."
  else
    apply_guest
  fi
  # Unsafe is deliberately manual. Never replay installers or mark an
  # unprovisioned VM ready just because a shell session was opened/closed.
  say 'Maintenance shell: network access is restricted to Squid setup allowlist.'
  status=0
  ssh -t -p "$SSH_PORT" -l root -i "$CLIENT" \
    -o "UserKnownHostsFile=$KNOWN" -o StrictHostKeyChecking=yes \
    -o IdentitiesOnly=yes 127.0.0.1 || status=$?
  if [ ! -f "$SECRET/provisioned" ]; then
    say "Still unprovisioned; run '$0 $NAME provision' when ready to finish setup."
  fi
  return "$status"
}

up_vm() {
  [ -f "$SECRET/provisioned" ] || die 'Not provisioned: run create (or unsafe for first boot)'
  case $NETWORK_WORK in offline|models) CURRENT_PROFILE=$NETWORK_WORK;; esac
  start_vm "$CURRENT_PROFILE"
  apply_guest
  verify_guest || die "Sandbox guest services are unhealthy; inspect $TMP/$NAME.verify.log"
  rm -f "$VM_SOCKET"
  ssh -N -p "$SSH_PORT" -l root -i "$CLIENT" \
    -o "UserKnownHostsFile=$KNOWN" -o StrictHostKeyChecking=yes \
    -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes \
    -o StreamLocalBindUnlink=yes \
    -L "$VM_SOCKET:/run/podman/podman.sock" \
    -L "127.0.0.1:$FORGEJO_PORT:127.0.0.1:$FORGEJO_PORT" \
    127.0.0.1 &
  TUNNEL_PID=$!
  sleep 1
  kill -0 "$TUNNEL_PID" 2>/dev/null || die 'SSH forwarding failed'
  say "Sandbox $NAME ready. Use '$0 $NAME sh', Forgejo at http://127.0.0.1:$FORGEJO_PORT"
  wait "$TUNNEL_PID"
}

