# Provide configuration paths for project-owned compose.
# Note: bind mounts refer to locations inside the Alpine VM
cmd_shell_env() {
  [ -S "$VM_SOCKET" ] || panic $EX_USAGE "No forwarded Podman socket"
  SHELL_MODE="$1"
  shift

  configure_docker_client
  DOCKER_HOST="unix://$VM_SOCKET"
  FIREBREAK_SANDBOX=$NAME
  FIREBREAK_MODE=$(cat "$ACTIVE_MODE")
  FIREBREAK_RUNTIME=$(runtime_for_profile "$FIREBREAK_MODE")
  FIREBREAK_GIT_URL="http://host.containers.internal:$FORGEJO_PORT/firebreak/workspace.git"
  FIREBREAK_GIT_CREDENTIALS_FILE=/var/lib/firebreak/worker-runtime/git-credentials
  FIREBREAK_GIT_HELPER_FILE=/var/lib/firebreak/worker-runtime/git-credential-helper
  FIREBREAK_GIT_USER="$GIT_USER"
  FIREBREAK_GIT_EMAIL="$GIT_EMAIL"
  export DOCKER_HOST FIREBREAK_SANDBOX FIREBREAK_MODE FIREBREAK_RUNTIME
  export FIREBREAK_GIT_USER FIREBREAK_GIT_EMAIL FIREBREAK_GIT_URL FIREBREAK_GIT_CREDENTIALS_FILE FIREBREAK_GIT_HELPER_FILE

  # The Forgejo worker token is created by VM reconciliation. Do not require
  # an import for unrelated Compose usage, but refuse stale/missing credentials
  # when a workspace is already imported.
  if [ -f "$SYNC_DIR/import-state" ]; then
    ssh_vm 'test -s /var/lib/firebreak/worker-runtime/git-credentials && test -x /var/lib/firebreak/worker-runtime/git-credential-helper' </dev/null || \
      panic $EX_CONFIG 'Worker credentials unavailable; restart the VM to reconcile provisioning'
  fi

  case $FIREBREAK_MODE in
    unsafe) label=UNSAFE ;;
    offline) label=WORK ;;
    models) label=WORK-MODELS ;;
    *) panic $EX_SOFTWARE "Unknown active mode: $FIREBREAK_MODE" ;;
  esac

  # Preserve non-interactive command execution
  if [ "$SHELL_MODE" = "sh" ] && [ "$#" -gt 0 ]; then
    exec "$@"
  fi

  printf '%s: %s | %s | %s\n' "$CLI_NAME" "$NAME" "$label" "$FIREBREAK_RUNTIME"
  PS1="[$CLI_NAME:$NAME:$label:$FIREBREAK_RUNTIME] \$ "
  export PS1

  case "$SHELL_MODE" in
    sh) exec /bin/sh -i ;;
    use)
      _user="${1:-guest}"
      _feature="${2:-opencode}"
      _shell="${3:-bash}"
      shift 3 || true
      info "Starting '$_shell' session with feature '$_feature' as '$_user' using 'compose.yml'"

      if [ ! -f "$STORE/compose.yml" ]; then
        panic $EX_CONFIG "Compose mode needs at least a '$STORE/compose.yml' file, for unsafe-mode customization also provide '$STORE/compose.unsafe.override.yml'"
      fi
      set -- -f "$STORE/compose.yml"
      if [ -f "$STORE/compose.$_feature.override.yml" ]; then
        set -- "$@" -f "$STORE/compose.$_feature.override.yml"
      fi
      if [ "$FIREBREAK_MODE" = "unsafe" ] && [ -f "$STORE/compose.unsafe.override.yml" ]; then
        set -- "$@" -f "$STORE/compose.unsafe.override.yml"
      fi

      # Note: Invoked by cleanup trap, if something goes wrong
      # shellcheck disable=SC2329
      cleanup() {
        status=$?
        trap - 0
        docker compose "$@" down --remove-orphans || :
        exit "$status"
      }

      trap 'cleanup "$@"' 0
      trap 'exit 130' INT
      trap 'exit 143' TERM

      if [ "$FIREBREAK_MODE" = "unsafe" ]; then
        docker compose "$@" up --build --force-recreate --detach || exit $?
      else
        docker compose "$@" up --force-recreate --detach || exit $?
      fi

      exec docker exec -u 1000 -it --workdir "/home/$_user" sandbox "$_shell"
    ;;
    *) panic $EX_SOFTWARE "Unknown shell mode $SHELL_MODE" ;;
  esac
}

cmd_vm_snapshot() {
  operation=$1

  [ -f "$DISK" ] || panic $EX_NOINPUT 'Sandbox disk does not exist'
  [ ! -d "$DISK.lock" ] || panic $EX_USAGE 'Stop sandbox before snapshots; disk is locked'

  require qemu-img qemu
  if [ "$operation" = --list ]; then qemu-img snapshot -l "$DISK"; return; fi
  label=$operation
  action=${2:-}

  valid_name "$label" || panic $EX_DATAERR 'Invalid snapshot name'
  case $action in
    new) flag=-c ;;
    restore) flag=-a ;;
    delete) flag=-d ;;
    *) panic $EX_USAGE 'Use snapshot NAME new|restore|delete' ;;
  esac
  qemu-img snapshot "$flag" "$label" "$DISK"
  if [ "$action" = restore ]; then
    rm -f "$SYNC_DIR/import-state" "$SYNC_DIR/import-pending" "$SYNC_DIR/import.bundle" "$SYNC_DIR/host-base" "$SYNC_DIR/guest-base"
    if [ "$label" = base ]; then
      rm -f "$SECRET/provisioned"
      info 'Restored pristine base; run unsafe and complete initial provisioning before up.'
    else
      info 'Snapshot restored; import metadata cleared (post-import snapshots require sync recovery).'
    fi
  fi
}

cmd_vm_delete() {
  [ -f "$DISK" ] || panic $EX_NOINPUT "Sandbox $NAME does not exist"
  [ ! -d "$DISK.lock" ] || panic $EX_USAGE 'Stop sandbox before deletion'
  # Explicit name, explicit disk. Do NOT erase shared image cache or secrets.
  rm -f "$DISK" "$SYNC_DIR/import-state" "$SYNC_DIR/import-pending" "$SYNC_DIR/import.bundle" "$SYNC_DIR/host-base" "$SYNC_DIR/guest-base"
  info "Deleted disk $DISK (SSH and Forgejo secrets preserved)"
}

# Only tracked host files enter the export. Forgejo Git HTTP moves objects;
# temporary bundles remain host-side, and no guest-controlled tar is unpacked.
git_host() { git -C "$ROOT" "$@"; }

ssh_checked() {
  [ -f "$DISK" ] || panic $EX_NOINPUT 'Missing VM disk'
  ssh_vm true </dev/null >/dev/null 2>&1 || panic $EX_UNAVAILABLE "Start '$0 $NAME up' or unsafe first"
}

make_snapshot_repo() {
  export_dir=$1
  history=$2
  depth=$3

  mkdir -p "$export_dir/repo"
  case $history in
    full)
      # A normal clone includes the real repository history and checked-out HEAD.
      rmdir "$export_dir/repo"
      git clone -q --no-local "$ROOT" "$export_dir/repo" || panic $EX_PROTOCOL 'Unable to clone host repository'
      git -C "$export_dir/repo" checkout -q -B main "$(git_host rev-parse HEAD)"
    ;;
    snapshot|shallow)
      git -C "$export_dir/repo" init -q
      if [ "$history" = snapshot ]; then
        commits=$(git_host rev-parse HEAD) || panic $EX_PROTOCOL 'Git repository requires HEAD'
      else
        commits=$(git_host rev-list --max-count="$depth" HEAD | sed '1!G;h;$!d')
      fi
      # In shallow mode recreate the last N commit *trees* as a new linear history.
      # This intentionally does not import earlier parents, tags, or remotes.
      for commit in $commits; do
        for path in "$export_dir/repo"/* "$export_dir/repo"/.[!.]* "$export_dir/repo"/..?*; do
          [ -e "$path" ] || [ -L "$path" ] || continue
          [ "${path##*/}" = .git ] || rm -rf "$path"
        done
        git_host archive "$commit" | tar -xf - -C "$export_dir/repo"
        if [ "$history" = shallow ]; then
          git -C "$export_dir/repo" add -A
          git -C "$export_dir/repo" -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" \
            commit -q --allow-empty -m "$(git_host log -1 --format=%s "$commit")"
        fi
      done
    ;;
    *) panic $EX_SOFTWARE 'Unsupported history policy';;
  esac
  # Incorporate modifications to TRACKED host files; no untracked files.
  git_host diff --binary HEAD > "$export_dir/working.patch"
  if [ -s "$export_dir/working.patch" ]; then
    git -C "$export_dir/repo" apply "$export_dir/working.patch" || panic $EX_SOFTWARE 'Could not apply tracked working tree changes'
  fi
  if [ "$history" = snapshot ]; then
    git -C "$export_dir/repo" add -A
    git -C "$export_dir/repo" -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" \
      commit -q --allow-empty -m 'Initial tracked workspace snapshot'
  elif [ -s "$export_dir/working.patch" ]; then
    git -C "$export_dir/repo" add -A
    git -C "$export_dir/repo" -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" \
      commit -q --allow-empty -m 'Uncommitted tracked host changes'
  fi
  git -C "$export_dir/repo" branch -q -M main
  git -C "$export_dir/repo" bundle create "$export_dir/import.bundle" refs/heads/main
}

# A short-lived authenticated Git client for the host-side localhost tunnel.
# The administrator password is read from the protected host secret file only
# when Git prompts for it. Nothing is written into the exported Git repository.
prepare_forgejo_host_auth() {
  require curl
  HOST_FORGEJO_NETRC=$temp/forgejo.netrc
  HOST_FORGEJO_ASKPASS=$temp/forgejo-askpass
  printf 'machine 127.0.0.1 login firebreak password %s\n' "$(cat "$SECRET/forgejo-password")" > "$HOST_FORGEJO_NETRC"
  chmod 600 "$HOST_FORGEJO_NETRC"
  cat > "$HOST_FORGEJO_ASKPASS" <<'EOF_ADMIN_ASKPASS'
#!/bin/sh
case $1 in
  *Username*) printf 'firebreak\n' ;;
  *Password*) cat "$FIREBREAK_HOST_ADMIN_PASSWORD_FILE" ;;
  *) exit 1 ;;
esac
EOF_ADMIN_ASKPASS
  chmod 700 "$HOST_FORGEJO_ASKPASS"
  FORGEJO_HOST_URL="http://127.0.0.1:$FORGEJO_PORT/firebreak/workspace.git"
  FORGEJO_API_URL="http://127.0.0.1:$FORGEJO_PORT/api/v1"
}

forgejo_api() {
  curl --noproxy '*' \
    --connect-timeout 5 \
    --max-time 40 \
    --netrc-file "$HOST_FORGEJO_NETRC" -sS "$@"
}

forgejo_host_git() (
  GIT_ASKPASS=$HOST_FORGEJO_ASKPASS
  FIREBREAK_HOST_ADMIN_PASSWORD_FILE=$SECRET/forgejo-password
  GIT_ASKPASS_REQUIRE=force
  GIT_TERMINAL_PROMPT=0
  GIT_CONFIG_GLOBAL=/dev/null
  GIT_CONFIG_NOSYSTEM=1
  export GIT_ASKPASS FIREBREAK_HOST_ADMIN_PASSWORD_FILE GIT_ASKPASS_REQUIRE GIT_TERMINAL_PROMPT
  export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM
  # Clear inherited credential helpers and HTTP proxy settings. The only
  # allowed endpoint is the SSH-forwarded, host-loopback Forgejo instance.
  git -c credential.helper= -c http.proxy= "$@"
)

# Only repository API operations use the admin identity. No guest Git
# checkout is ever created, and the admin token is never mounted into Compose.
ensure_forgejo_repository() {
  code=$(forgejo_api -o /dev/null -w '%{http_code}' \
    "$FORGEJO_API_URL/repos/firebreak/workspace") || panic $EX_UNAVAILABLE 'Cannot query Forgejo repository'
  case $code in
    200) : ;;
    404)
      forgejo_api -f -H 'Content-Type: application/json' -X POST \
        -d '{"name":"workspace","private":true,"default_branch":"main"}' \
        "$FORGEJO_API_URL/user/repos" >/dev/null || panic $EX_CANTCREAT 'Could not create Forgejo repository'
    ;;
    *) panic $EX_PROTOCOL "Forgejo repository lookup returned HTTP $code" ;;
  esac
}

# The worker's rights are enforced by Forgejo, not by a client-side hook.
ensure_forgejo_worker_permissions() {
  # Ensure the guest has generated its worker token, but never copy it to Mac.
  ssh_vm 'test -s /etc/firebreak/forgejo-worker-token && test -r /var/lib/firebreak/worker-runtime/git-credentials' </dev/null || \
    panic $EX_NOINPUT 'Worker token missing from Alpine; restart the sandbox to reconcile Forgejo'
  protect="$FORGEJO_API_URL/repos/firebreak/workspace/branch_protections/main"
  code=$(forgejo_api -o /dev/null -w '%{http_code}' "$protect") || \
    panic $EX_PROTOCOL 'Cannot inspect Forgejo branch protection'
  # Deliberately leave admins exempt so Firebreak can perform maintenance.
  policy='{"rule_name":"main","enable_push":false,"enable_push_whitelist":false,"enable_force_push":false,"apply_to_admins":false}'
  case $code in
    404)
      forgejo_api -f -X POST -H 'Content-Type: application/json' -d "$policy" \
        "$FORGEJO_API_URL/repos/firebreak/workspace/branch_protections" >/dev/null || \
        panic $EX_PROTOCOL 'Could not protect Forgejo main'
    ;;
    200)
      forgejo_api -f -X PATCH -H 'Content-Type: application/json' -d "$policy" \
        "$protect" >/dev/null || panic $EX_PROTOCOL 'Could not reconcile Forgejo main protection'
    ;;
    *) panic $EX_PROTOCOL "Forgejo main protection query returned HTTP $code" ;;
  esac
  protection=$(forgejo_api -f "$protect") || panic $EX_PROTOCOL 'Cannot verify Forgejo main protection'
  printf '%s' "$protection" | grep -Eq '"enable_push"[[:space:]]*:[[:space:]]*false' || \
    panic $EX_PROTOCOL 'Forgejo main allows pushes; refusing to finish import'
  # Only grant write access AFTER main's protection has been verified.
  forgejo_api -f -X PUT -H 'Content-Type: application/json' \
    -d '{"permission":"write"}' \
    "$FORGEJO_API_URL/repos/firebreak/workspace/collaborators/sbx-worker" >/dev/null || \
    panic $EX_PROTOCOL 'Cannot grant Forgejo worker repository access'
  perm=$(forgejo_api -f \
    "$FORGEJO_API_URL/repos/firebreak/workspace/collaborators/sbx-worker/permission") || \
    panic $EX_PROTOCOL 'Cannot verify Forgejo worker permissions'
  printf '%s' "$perm" | grep -Eq '"permission"[[:space:]]*:[[:space:]]*"write"' || \
    panic $EX_PROTOCOL 'Forgejo worker did not receive Write permission'
  # Authenticated read of the imported work branch using the worker token.
  ssh_vm "FIREBREAK_GIT_CREDS=/var/lib/firebreak/worker-runtime/git-credentials GIT_TERMINAL_PROMPT=0 git -c credential.helper='!/var/lib/firebreak/worker-runtime/git-credential-helper' -c http.proxy= ls-remote 'http://127.0.0.1:$FORGEJO_PORT/firebreak/workspace.git' refs/heads/work" \
    </dev/null >/dev/null || panic $EX_NOINPUT 'Worker credential cannot read Forgejo work branch'
  # ssh_vm "GIT_TERMINAL_PROMPT=0 git -c credential.helper='!/var/lib/firebreak/worker-runtime/git-credential-helper' -c http.proxy= ls-remote 'http://127.0.0.1:$FORGEJO_PORT/firebreak/workspace.git' refs/heads/work" \
  #   </dev/null >/dev/null || panic $EX_NOINPUT 'Worker credential cannot read Forgejo work branch'
}

# Temporary bare repositories receive data from the local host's exported
# bundle (push) or directly from Forgejo (pull). No persistent guest checkout.
read_forgejo_refs() {
  refs=$(forgejo_host_git ls-remote --heads "$FORGEJO_HOST_URL" main work) || \
    panic $EX_PROTOCOL 'Cannot inspect Forgejo Git refs'
  remote_main=$(printf '%s\n' "$refs" | awk '$2 == "refs/heads/main" {print $1}')
  remote_work=$(printf '%s\n' "$refs" | awk '$2 == "refs/heads/work" {print $1}')
}

# One invocation grants a specific host state to the sandbox. The import-state
# file is a single atomic record so interrupted writes cannot create a half
# valid pair of host/guest baselines. Pull does not clear this record.
cmd_sync_push() {
  history=$GIT_IMPORT
  depth=5
  allow_sensitive=no

  for opt do
    case $opt in
      --history=*) history=${opt#*=} ;;
      --depth=*) depth=${opt#*=} ;;
      # --allow-sensitive-tracked) allow_sensitive=yes ;;
      # --replace) panic $EX_SOFTWARE 'Import is one-shot; create/restore a sandbox instead of --replace' ;;
      *) panic $EX_USAGE "Unknown push option: $opt" ;;
    esac
  done
  case $history in
    snapshot|shallow|full) : ;;
    *) panic $EX_USAGE 'Expected --history=snapshot|shallow|full' ;;
  esac
  case $depth in
    ''|*[!0-9]*) panic $EX_USAGE 'depth must be integer' ;;
  esac
  [ "$depth" -ge 1 ] && [ "$depth" -le 50 ] || panic $EX_USAGE 'depth must be 1..50'

  require git
  require tar

  git_host rev-parse --verify HEAD >/dev/null 2>&1 || panic $EX_USAGE 'Run push from a Git repository with at least one commit'
  if [ "$allow_sensitive" = no ]; then
    flagged=$(git_host ls-files -- '.env' '.env.*' '**/.env' '**/.env.*' '.npmrc' '**/.npmrc' '.pypirc' '**/.pypirc' '*.pem' '*.p12' '*.key' 2>/dev/null)
    [ -z "$flagged" ] || panic $EX_DATAERR 'Tracked files match common secret paths; inspect them and explicitly pass --allow-sensitive-tracked if intentional'
  fi
  [ ! -e "$SYNC_DIR/import-state" ] || panic $EX_USAGE 'This sandbox has already been imported; use pull, or start a new sandbox'
  [ ! -e "$SYNC_DIR/host-base" ] && [ ! -e "$SYNC_DIR/guest-base" ] || \
    panic $EX_USAGE 'Legacy sync metadata exists; do not reimport until it has been reviewed'
  ssh_checked

  mkdir -p "$SYNC_DIR" "$TMP"
  temp=$(mktemp -d "$TMP/import.XXXXXX") || panic $EX_CANTCREAT 'Cannot create import temporary directory'
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  prepare_forgejo_host_auth

  if [ -f "$SYNC_DIR/import-pending" ] && [ -f "$SYNC_DIR/import.bundle" ]; then
    read -r hostbase guestbase previous_history previous_depth < "$SYNC_DIR/import-pending" || \
      panic $EX_NOINPUT 'Cannot read pending import metadata'
    [ "$history" = "$previous_history" ] && [ "$depth" = "$previous_depth" ] || \
      panic $EX_TEMPFAIL 'An import is pending; retry with the same history and depth options'
    info 'Resuming the original interrupted import; host changes since its creation are not included.'
  else
    [ ! -e "$SYNC_DIR/import-pending" ] && [ ! -e "$SYNC_DIR/import.bundle" ] || \
      panic $EX_SOFTWARE 'Incomplete pending import state; inspect sync directory before retrying'
    make_snapshot_repo "$temp" "$history" "$depth"
    guestbase=$(git -C "$temp/repo" rev-parse HEAD)
    hostbase=$(git_host rev-parse HEAD)
    state_tmp=$(mktemp "$SYNC_DIR/import-pending.XXXXXX") || panic $EX_CANTCREAT 'Cannot stage import baseline'
    printf '%s %s %s %s\n' "$hostbase" "$guestbase" "$history" "$depth" > "$state_tmp"
    mv -f "$temp/import.bundle" "$SYNC_DIR/import.bundle"
    mv -f "$state_tmp" "$SYNC_DIR/import-pending"
  fi

  # Reconstruct the exact same authorized commit from the preserved bundle.
  git init -q --bare "$temp/import.git"
  git --git-dir="$temp/import.git" fetch -q "$SYNC_DIR/import.bundle" \
    '+refs/heads/main:refs/heads/main' || panic $EX_NOINPUT 'Could not read pending import bundle'
  incoming=$(git --git-dir="$temp/import.git" rev-parse refs/heads/main) || panic $EX_NOINPUT 'Missing bundle main'
  [ "$incoming" = "$guestbase" ] || panic $EX_DATAERR 'Pending import metadata does not match its bundle'
  git --git-dir="$temp/import.git" update-ref refs/heads/work "$incoming"
  ensure_forgejo_repository
  read_forgejo_refs

  [ -n "$remote_main" ] || [ -z "$remote_work" ] || \
    panic $EX_SOFTWARE 'Forgejo has work without main; manual recovery required'
  if [ -n "$remote_main" ] && [ "$remote_main" != "$incoming" ]; then
    panic $EX_CANTCREAT 'Forgejo main differs from the pending import; refusing to overwrite it'
  fi
  if [ -n "$remote_work" ]; then
    forgejo_host_git --git-dir="$temp/import.git" fetch -q "$FORGEJO_HOST_URL" \
      '+refs/heads/work:refs/remotes/forgejo/work' || panic $EX_NOINPUT 'Could not fetch existing Forgejo work'
    git --git-dir="$temp/import.git" merge-base --is-ancestor \
      "$incoming" refs/remotes/forgejo/work || panic $EX_SOFTWARE 'Existing Forgejo work has an unexpected baseline'
  fi

  # Publish the host-owned baseline first, then create work if still absent.
  # Neither operation uses force; an interrupted run can safely resume.
  if [ -z "$remote_main" ]; then
    forgejo_host_git --git-dir="$temp/import.git" push -q "$FORGEJO_HOST_URL" \
      refs/heads/main:refs/heads/main || panic $EX_SOFTWARE 'Forgejo refused the baseline push'
  fi
  if [ -z "$remote_work" ]; then
    forgejo_host_git --git-dir="$temp/import.git" push -q "$FORGEJO_HOST_URL" \
      refs/heads/work:refs/heads/work || panic $EX_SOFTWARE 'Forgejo refused the initial work push'
  fi

  ensure_forgejo_worker_permissions
  # Only mark complete after main/work are published AND worker protection works.
  state_tmp=$(mktemp "$SYNC_DIR/import-state.XXXXXX") || panic $EX_CANTCREAT 'Cannot record import baseline'
  printf '%s %s\n' "$hostbase" "$guestbase" > "$state_tmp"
  mv -f "$state_tmp" "$SYNC_DIR/import-state"
  rm -f "$SYNC_DIR/import-pending" "$SYNC_DIR/import.bundle"
  info "Imported tracked files as $history history (guest baseline $guestbase)."
  info 'Forgejo: immutable main and sandbox-owned work; clone work inside your project container.'
}

# Import a committed Forgejo checkpoint as a synthetic host-side review commit,
# The guest baseline is trusted only if it is an ancestor of the exported work.
create_review_branch() {
  bundle=$1
  hostbase=$2
  guestbase=$3

  git_host fetch -q "$bundle" 'refs/heads/work' || panic $EX_PROTOCOL 'Could not import sandbox bundle'
  guesttip=$(git_host rev-parse FETCH_HEAD)
  git_host cat-file -e "$guestbase^{commit}" 2>/dev/null || panic $EX_NOINPUT 'Guest baseline is missing from fetched history'
  git_host merge-base --is-ancestor "$guestbase" "$guesttip" || panic $EX_USAGE 'Guest history was rewritten; refusing unsafe sync'
  if git_host diff --quiet "$guestbase" "$guesttip"; then
    info 'No committed sandbox file changes to export yet.'
    return 0
  fi
  # Export resulting guest tree relative to the original HOST commit.
  # Host tracked-but-dirty input is included; host working tree is untouched.
  git_host diff --binary "$hostbase" "$guesttip" > "$temp/changes.patch"
  GIT_INDEX_FILE=$temp/index; export GIT_INDEX_FILE
  git_host read-tree "$hostbase"
  if [ -s "$temp/changes.patch" ]; then
    git_host apply --cached "$temp/changes.patch" || panic $EX_SOFTWARE 'Sandbox changes conflict with host baseline; review diff manually'
  fi
  tree=$(git_host write-tree)
  branch=firebreak/$NAME/$(printf '%s' "$guesttip" | cut -c1-12)
  if git_host show-ref --verify --quiet "refs/heads/$branch"; then
    info "Already exported this checkpoint as $branch; left existing branch untouched."
    return 0
  fi
  commit=$(printf 'Import sandbox %s changes from %s\n' "$NAME" "$guesttip" | \
    git_host -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" commit-tree "$tree" -p "$hostbase")
  git_host update-ref "refs/heads/$branch" "$commit" '0000000000000000000000000000000000000000' || \
    panic $EX_CANTCREAT 'Could not create host review branch'
  info "Created host review branch $branch (host working tree untouched)."
}

cmd_sync_pull() {
  require git

  [ -f "$SYNC_DIR/import-state" ] || panic $EX_NOINPUT 'No recorded import: push first'
  read -r hostbase guestbase < "$SYNC_DIR/import-state" || panic $EX_NOINPUT 'Cannot read import baseline'
  git_host cat-file -e "$hostbase^{commit}" 2>/dev/null || panic $EX_NOINPUT 'Original host baseline commit is missing'
  case $guestbase in
    ''|*[!0-9a-f]*) panic $EX_SOFTWARE 'Corrupt guest baseline metadata' ;;
  esac
  case ${#guestbase} in
    40|64) : ;;
    *) panic $EX_SOFTWARE 'Corrupt guest baseline metadata' ;;
  esac
  ssh_checked
  temp=$(mktemp -d "$TMP/pull.XXXXXX") || panic $EX_CANTCREAT 'Cannot create pull temporary directory'
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  prepare_forgejo_host_auth

  git init -q --bare "$temp/forgejo.git"
  # Fetch only Forgejo's two published branches over the localhost tunnel.
  # There is no guest checkout and no guest-generated tar to unpack.
  forgejo_host_git --git-dir="$temp/forgejo.git" fetch -q "$FORGEJO_HOST_URL" \
    '+refs/heads/main:refs/heads/main' '+refs/heads/work:refs/heads/work' || \
    panic $EX_PROTOCOL 'Cannot fetch Forgejo main and work'
  actual_main=$(git --git-dir="$temp/forgejo.git" rev-parse refs/heads/main) || panic $EX_SOFTWARE 'Forgejo has no main'
  [ "$actual_main" = "$guestbase" ] || panic $EX_DATAERR 'Forgejo baseline main was changed; refusing export'
  git --git-dir="$temp/forgejo.git" merge-base --is-ancestor \
    "$guestbase" refs/heads/work || panic $EX_DATAERR 'Forgejo work does not descend from the authorized baseline'
  git --git-dir="$temp/forgejo.git" bundle create "$temp/return.bundle" refs/heads/work || \
    panic $EX_CANTCREAT 'Could not create review bundle'

  create_review_branch "$temp/return.bundle" "$hostbase" "$guestbase"
  # Import record stays intact: subsequent checkpoints are non-destructive.
}

cmd_vm_doctor() {
  info "$CLI_NAME $CLI_VERSION, sandbox $NAME"
  info "  image: $(image_name)"
  info "  disk: $DISK"
  info "  exists: $(test -f "$DISK" && echo yes || echo no)"
  info "  provisioned: $(test -f "$SECRET/provisioned" && echo yes || echo no)"
  info "  locked: $(test -d "$DISK.lock" && echo yes || echo no)"
  info "  network_work: $NETWORK_WORK (QEMU restrict=on in all profiles)"
  info "  ssh port: $SSH_PORT; Forgejo: $FORGEJO_PORT"
  if [ -f "$SECRET/storage" ]; then
    info "  storage: $(cat "$SECRET/storage")"
  fi
  if [ -f "$SEED/network-config" ]; then
    info "  seed MAC: $(grep macaddress "$SEED/network-config" | tr -d ' \"')"
  fi
  if ssh_vm true </dev/null >/dev/null 2>&1; then
    info '  SSH: reachable'
    ssh_vm 'cloud-init status || true; rc-service forgejo status || true; rc-service podman status || true'
  else
    info '  SSH: not reachable (VM may be off)'
  fi
}

cmd_self_test() {
  sh -n "$0" || panic $EX_DATAERR 'POSIX shell parser rejected firebreak'
  for mode in offline models unsafe; do
    args=$(net_args "$mode")
    case $args in
      *restrict=on*) : ;;
      *) panic $EX_SOFTWARE "Unrestricted $mode policy forbidden" ;;
    esac
  done
  case $(net_args offline) in
    *10.0.2.100:3128*) panic $EX_SOFTWARE 'Offline mode exposes proxy' ;;
  esac
  valid_name valid-demo || panic $EX_SOFTWARE 'Name policy broke'
  if valid_name '../escape'; then
    panic $EX_SOFTWARE 'Traversal accepted'
  fi
  info 'Built-in configuration and isolation-policy smoke checks passed.'
  cmd_config proxy-check
  # cmd_config proxy-check --online
    # proxy-check)
    #   case ${1:-} in ''|--online) :;; *) panic $EX_SOFTWARE 'proxy-check accepts only --online';; esac
}

main() {
  case ${1:-} in
    --self-test) cmd_self_test; exit $EX_OK ;;
    --version) printf '%s\n' "$CLI_VERSION"; exit $EX_OK ;;
    --help|'') print_usage ;;
    --list)
      for img in "$VMS"/*.qcow2; do
        [ -f "$img" ] && printf '%s\n' "${img##*/}"
      done
      exit $EX_OK
    ;;
    config) shift; cmd_config "$@"; exit $EX_OK ;;
  esac

  [ -f "$CONF" ] || panic $EX_USAGE "Run '$CLI_NAME config init' first"
  load_conf
  [ "$#" -ge 2 ] || print_usage
  configure_vm_paths "$1"

  cmd="$2"
  shift 2
  case $cmd in
    new) cmd_vm_new "$@" ;;
    unsafe) [ "$#" -eq 0 ] || panic $EX_USAGE 'unsafe takes no arguments'; cmd_vm_unsafe ;;
    logs) cmd_logs "$@" ;;
    up) [ "$#" -eq 0 ] || panic $EX_USAGE 'up takes no arguments'; cmd_vm_up ;;
    sh) cmd_shell_env "sh" "$@" ;;
    use) cmd_shell_env "use" "${1:-}" "${2:-}" "${3:-}" ;;
    snapshot) [ "$#" -ge 1 ] || panic $EX_USAGE 'Specify a snapshot name'; cmd_vm_snapshot "$@" ;;
    push) cmd_sync_push "$@" ;;
    pull) [ "$#" -eq 0 ] || panic $EX_USAGE 'pull takes no arguments'; cmd_sync_pull ;;
    doctor) cmd_vm_doctor ;;
    delete) cmd_vm_delete ;;
    __test-runtime) [ "$#" -eq 1 ] || panic $EX_USAGE 'Expected runtime profile'; runtime_for_profile "$1" ;;
    __test-net) [ "$#" -eq 1 ] || panic $EX_USAGE 'Expected test mode'; net_args "$1" ;;
    __test-qemu)
      [ "$#" -eq 1 ] || panic $EX_USAGE 'Expected serial mode'
      SERIAL_LOG=$TMP/$NAME.serial.log
      FIRMWARE=$IMAGES/test-firmware
      MAC=$(mac_from_string "$VERSION-$BUILD-$NAME")
      qemu_vm "$DISK" "$SEEDS/$NAME" "$MAC" unsafe "$1"
    ;;
    __test-render) render_seed "$NAME"; printf '%s\n' "$SEED" ;;
    __test-export)
      [ "$#" -eq 3 ] || panic $EX_SOFTWARE 'Expected DIRECTORY HISTORY DEPTH'
      make_snapshot_repo "$1" "$2" "$3"
    ;;
    __test-review)
      [ "$#" -eq 3 ] || panic $EX_SOFTWARE 'Expected BUNDLE HOST_BASE GUEST_BASE'
      temp=$(mktemp -d "$TMP/review.XXXXXX")
      trap 'rm -rf "$temp"' EXIT HUP INT TERM
      create_review_branch "$1" "$2" "$3"
    ;;
    __unsafe-qemu) [ "$#" -eq 0 ] || panic $EX_USAGE 'unsafe takes no arguments'; cmd_vm_unsafe_qemu ;;
    __repair|provision) [ "$#" -eq 0 ] || panic $EX_USAGE "$cmd takes no arguments"; cmd_vm_provision ;;
    __debug) [ "$#" -eq 0 ] || panic $EX_USAGE 'debug takes no arguments'; cmd_vm_debug ;;
    __console-password) [ "$#" -eq 0 ] || panic $EX_USAGE 'console-password takes no arguments'; cmd_console_password ;;
    *) panic $EX_USAGE "Unknown command '$cmd'" ;;
  esac
}

main "$@"

)

cli "$@"
