[ "$actual_runtime" = "$selected_runtime" ] || {
  printf 'Firebreak: expected OCI runtime %s but Podman reports %s\n' "$selected_runtime" "$actual_runtime" >&2
  exit 1
}
printf '%s\n' "$policy_hash" > /etc/firebreak/podman-policy-hash
# The project is intentionally mounted read-only as an explicit guest share.
mkdir -p /var/lib/firebreak/workspaces
