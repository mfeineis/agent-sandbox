render_guest_apply() {
  # No shell-interpreted input can contain arbitrary syntax. Output writes the
  # only runtime files we own; it NEVER deletes user files or upgrades packages.
  case $SANDBOX_STORAGE in ephemeral) OVERLAY=all:memory;; persistent) OVERLAY=none;; esac
  cat <<'EOF_APPLY'
