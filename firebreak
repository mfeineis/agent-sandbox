# Homebrew keeps Squid in opt/squid/sbin (usually outside the interactive PATH).
# Return an executable PATH, never rely on shell aliases or exported functions.
resolve_squid() {
  if [ -n "$FIREBREAK_SQUID" ]; then
    case $FIREBREAK_SQUID in
      /*) : ;;
      *) panic $EX_CONFIG 'FIREBREAK_SQUID must be an absolute path' ;;
    esac
    [ -f "$FIREBREAK_SQUID" ] && [ -x "$FIREBREAK_SQUID" ] || panic $EX_NOPERM "Squid not executable: $FIREBREAK_SQUID"
    printf '%s\n' "$FIREBREAK_SQUID"
    exit $EX_OK
  fi
  candidate=$(command -v squid 2>/dev/null) || candidate=
  # Ignore alias/function output: only absolute, executable file paths are valid.
  case $candidate in
    /*)
      if [ -f "$candidate" ] && [ -x "$candidate" ]; then
        printf '%s\n' "$candidate"
        exit $EX_OK
      fi
    ;;
  esac
  if command -v brew >/dev/null 2>&1; then
    prefix=$(brew --prefix squid 2>/dev/null) || prefix=
    if [ -n "$prefix" ] && [ -f "$prefix/sbin/squid" ] && [ -x "$prefix/sbin/squid" ]; then
      printf '%s\n' "$prefix/sbin/squid"
      exit $EX_OK
    fi
  fi
  for candidate in /opt/homebrew/opt/squid/sbin/squid /usr/local/opt/squid/sbin/squid; do
    if [ -f "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      exit $EX_OK
    fi
  done
  panic $EX_UNAVAILABLE "Missing dependency 'squid' (try: brew install squid; or set FIREBREAK_SQUID=/absolute/path/to/squid)"
}

valid_name() { case $1 in ''|*[!a-zA-Z0-9_.-]*|.|..|.*) return 1;; esac; return 0; }

valid_port() { case $1 in ''|*[!0-9]*) return 1;; esac; [ "$1" -gt 0 ] && [ "$1" -le 65535 ]; }

valid_dnsname() { case $1 in ''|*[!a-zA-Z0-9.-]*|.*|*..*|*.) return 1;; esac; return 0; }

valid_list() { case $1 in *[!a-zA-Z0-9,_.-]*) return 1;; esac; return 0; }

valid_version() { printf '%s\n' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; }

mac_from_string() {
  require shasum
  hash=$(printf '%s' "$1" | shasum -a 256 | awk '{print $1}')
  printf '52:54:00:%s:%s:%s\n' \
    "$(printf '%s' "$hash" | cut -c1-2)" \
    "$(printf '%s' "$hash" | cut -c3-4)" \
    "$(printf '%s' "$hash" | cut -c5-6)"
}

rand_hex() { od -An -N "$1" -tx1 /dev/urandom | tr -d ' \n'; }

write_if_changed() {
  # stdin -> path; replace atomically and only on actual changes
  dest=$1
  mkdir -p "$(dirname "$dest")"
  temp=$(mktemp "${dest}.XXXXXX") || return 1
  cat > "$temp"
  if [ -f "$dest" ] && cmp -s "$temp" "$dest"; then
    rm -f "$temp"
  else
    mv -f "$temp" "$dest"
  fi
}

# Restricted plain KEY=value allow-list dotenv format
read_config() {
  [ -f "$CONF" ] || return 0
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case $key in ''|\#*) continue;; esac
    case $key in
      alpine_version) ALPINE_VERSION=$value ;;
      alpine_revision) ALPINE_REVISION=$value ;;
      alpine_mirror) ALPINE_MIRROR=$value ;;
      git_user) GIT_USER=$value ;;
      git_email) GIT_EMAIL=$value ;;
      git_import) GIT_IMPORT=$value ;;
      storage) STORAGE=$value ;;
      memory_mb) VM_MEMORY=$value ;;
      cpus) VM_CPUS=$value ;;
      disk_size) VM_SIZE=$value ;;
      ssh_port) SSH_PORT=$value ;;
      forgejo_port) FORGEJO_PORT=$value ;;
      squid_port) SQUID_PORT=$value ;;
      squid_models_port) SQUID_MODELS_PORT=$value ;;
      network_work) NETWORK_WORK=$value ;;
      models) MODELS=$value ;;
      boot_timeout) BOOT_TIMEOUT=$value ;;
      runtime_unsafe) RUNTIME_UNSAFE=$value ;;
      runtime_offline) RUNTIME_OFFLINE=$value ;;
      runtime_models) RUNTIME_MODELS=$value ;;
      forgejo_package) FORGEJO_PACKAGE=$value ;;
      *) : ;; # Unknown keys are deliberately ignored and preserved.
    esac
  done < "$CONF"
}

validate_config() {
  valid_version "$ALPINE_VERSION" || panic $EX_CONFIG 'Invalid alpine_version'
  case $ALPINE_REVISION in
    r[0-9]*)
      case ${ALPINE_REVISION#r} in
        *[!0-9]*|'') panic $EX_CONFIG 'Invalid alpine_revision' ;;
      esac
    ;;
    *) panic $EX_CONFIG 'Invalid alpine_revision' ;;
  esac
  case $ALPINE_MIRROR in
    https://*) : ;;
    *) panic $EX_CONFIG 'Alpine mirror must use HTTPS' ;;
  esac
  case $ALPINE_MIRROR in
    *[!a-zA-Z0-9/_.:-]*) panic $EX_CONFIG 'Invalid Alpine mirror URL' ;;
  esac
  case $STORAGE in
    ephemeral|persistent) : ;;
    *) panic $EX_CONFIG 'storage must be ephemeral or persistent' ;;
  esac
  case $GIT_IMPORT in
    snapshot|shallow|full) : ;;
    *) panic $EX_CONFIG 'git_import must be snapshot, shallow, or full' ;;
  esac
  case $NETWORK_WORK in
    offline|models) : ;;
    *) panic $EX_CONFIG 'network_work must be offline or models' ;;
  esac
  case $BOOT_TIMEOUT in
    ''|*[!0-9]*) panic $EX_CONFIG 'boot_timeout must be 0-30 seconds' ;;
  esac
  [ "$BOOT_TIMEOUT" -le 30 ] || panic $EX_CONFIG 'boot_timeout must be 0-30 seconds'
  for selected in "$RUNTIME_UNSAFE" "$RUNTIME_OFFLINE" "$RUNTIME_MODELS"; do
    case $selected in
      crun|runsc) : ;;
      *) panic $EX_CONFIG "Unsupported OCI runtime: $selected (expected crun or runsc)" ;;
    esac
  done
  case $FORGEJO_PACKAGE in
    forgejo|forgejo-lts) : ;;
    *) panic $EX_CONFIG 'unsupported Forgejo package' ;;
  esac
  valid_list "$MODELS" || panic $EX_CONFIG 'models must be comma-separated identifiers'
  for n in "$SSH_PORT" "$FORGEJO_PORT" "$SQUID_PORT" "$SQUID_MODELS_PORT"; do
    valid_port "$n" || panic $EX_CONFIG "invalid port $n"
  done
  for n in "$VM_MEMORY" "$VM_CPUS"; do
    case $n in
      ''|*[!0-9]*) panic $EX_CONFIG "invalid integer $n" ;;
    esac
    [ "$n" -gt 0 ] || panic $EX_CONFIG 'values must be positive'
  done
  case $VM_SIZE in
    *[!0-9GM]*) panic $EX_CONFIG 'disk_size must be an integer followed by G or M' ;;
  esac
  case $GIT_USER$GIT_EMAIL in
    *'\n'*|*'\r'*) panic $EX_CONFIG 'invalid Git identity' ;;
  esac
  # Model policies never accept arbitrary proxy targets from inside the guest.
  saved_ifs=$IFS; IFS=,; set -- "$MODELS"; IFS=$saved_ifs
  for model do
    case $model in
      ''|ollama|anthropic|openai|openrouter) : ;;
      *) panic $EX_CONFIG "unknown model provider: $model" ;;
    esac
  done
}

