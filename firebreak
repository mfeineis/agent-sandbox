config_cmd() {
  action=${1:-}; shift || true
  case $action in
    init)
      init_conf; load; ensure_dirs; ensure_ignored; render_proxy_config
      if [ "${1:-}" = --install-deps ]; then
        [ "$(uname -s)" = Darwin ] || die 'brew install is only available on macOS'
        need brew
        brew install qemu socat squid gnupg coreutils
      elif [ "$#" -ne 0 ]; then die "unknown argument: $1"; fi
      say "Initialized $CONF and $STORE (no VM created)."
      ;;
    update|upgrade)
      [ -f "$ROOT/$CONF" ] || die 'Run config init first'
      load; ensure_dirs; ensure_ignored
      if [ "${1:-}" = --refresh-image ]; then
        # Discover the highest available revision of the exact configured release.
        need curl; need sort; need sed
        page=$(curl -fsSL "${ALPINE_MIRROR%/}/v$(printf %s "$ALPINE_VERSION" | cut -d. -f1-2)/releases/cloud/") || die 'Unable to query Alpine cloud image index'
        latest=$(printf '%s\n' "$page" | grep -o "generic_alpine-${ALPINE_VERSION}-aarch64-uefi-cloudinit-r[0-9][0-9]*.qcow2" | sort -u | sed 's/.*-r\([0-9][0-9]*\).qcow2/r\1/' | sort -t r -k2,2n | tail -n 1)
        [ -n "$latest" ] || die 'No matching cloud image revision in index'
        if [ "$latest" != "$ALPINE_REVISION" ]; then
          # Keep all unknown keys, comments and user changes untouched.
          sed "s/^alpine_revision=.*/alpine_revision=$latest/" "$ROOT/$CONF" | write_if_changed "$ROOT/$CONF"
          ALPINE_REVISION=$latest
        fi
      elif [ "$#" -ne 0 ]; then die "unknown argument: $1"; fi
      render_proxy_config
      for disk in "$VMS"/*.qcow2; do
        [ -f "$disk" ] || continue
        base=${disk##*/}; vm_paths "${base%.qcow2}"
        [ ! -d "$disk.lock" ] || die "Stop sandbox $NAME before updating its seed"
        render_seed "$NAME"
      done
      say 'Configuration reconciled on disk; guest runtime policies apply on next VM start.'
      ;;
    proxy-check)
      case ${1:-} in ''|--online) :;; *) die 'proxy-check accepts only --online';; esac
      [ "$#" -le 1 ] || die 'proxy-check accepts only --online'
      online=${1:-no}
      [ -f "$ROOT/$CONF" ] || die 'Run config init first'
      load; ensure_dirs; render_proxy_config
      # Isolated subshell: the real VM supervisor's PID/trap state is untouched.
      (
        SQUID_PID=
        trap '[ -z "$SQUID_PID" ] || { kill "$SQUID_PID" 2>/dev/null || :; wait "$SQUID_PID" 2>/dev/null || :; }' 0
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM
        start_squid
        if [ "$online" = --online ]; then
          need curl
          say 'Testing the actual setup proxy against the gVisor release endpoint...'
          if ! curl --fail --show-error --silent --head --location \
              --connect-timeout 20 --max-time 40 \
              --proxy "http://127.0.0.1:$SQUID_PORT" --noproxy '' \
              'https://storage.googleapis.com/gvisor/releases/release/latest/aarch64/gvisor.tar.bz2' \
              > "$PROXY/online-check.log" 2>&1; then
            say 'Proxy online check failed:'
            tail -n 15 "$PROXY/online-check.log" >&2 || :
            say 'Recent Squid transactions:'
            tail -n 15 "$PROXY/access.log" >&2 2>/dev/null || :
            die 'Setup proxy cannot reach gVisor (no VM needed)'
          fi
          say 'gVisor endpoint reachable through Squid.'
        fi
        say 'Squid policy and foreground startup OK; test process stopped.'
      )
      ;;
    *) die 'Expected: config init|update|proxy-check';;
  esac
}

  verify_gpg_signature() (
    fingerprint=$1
    keyfile=$2
    sig=$3
    bin=$4

    # Normalize fingerprint: remove whitespace, uppercase hex.
    expected=$(printf '%s' "$fingerprint" |
      tr -d '[:space:]' |
      tr '[:lower:]' '[:upper:]')

    # Reject malformed fingerprints.
    case "$expected" in
      *[!0123456789ABCDEF]*|'')
        die "Invalid fingerprint"
      ;;
    esac

    case ${#expected} in
      40|64) ;;
      *)
        die "Unexpected fingerprint length"
      ;;
    esac

    # Isolated GPG environment.
    tmpdir=$(mktemp -d) || die "could not create temp directory"
    trap 'rm -rf "$tmpdir"' 0
    trap 'exit 1' 1 2 3 15

    chmod 700 "$tmpdir" || die "could not chmod temp directory"

    # Import the supplied public key
    gpg --homedir "$tmpdir" --batch --no-tty \
      --import "$keyfile" || die "pubkey import failed"

    actual=$(
      gpg --homedir "$tmpdir" --batch --with-colons --fingerprint --list-keys |
      awk -F: '
        $1 == "pub" {
          count++
          want_fpr = 1
          next
        }
        $1 == "fpr" && want_fpr {
          fingerprint = $10
          want_fpr = 0
        }
        END {
          if (count != 1 || fingerprint == "")
            exit 1
          print fingerprint
        }
      '
    ) || die "could not extract exactly one required primary-key fingerprint"

    if [ "$actual" != "$expected" ]; then
      echo "Key fingerprint mismatch!" >&2
      echo "Expected: $expected" >&2
      echo "Actual:   $actual" >&2
      die
    fi

    # Cryptographically verify the signature, we trust it because we do
    # our own explicit fingerprint validation and have obtained both
    # fingerprint and public key by hand.
    # Keeping the machine-readable status for the next check.
    if ! gpg --homedir "$tmpdir" --batch --no-tty \
      --trust-model always --assert-signer "$expected" --quiet \
      --status-fd 1 --verify "$sig" "$bin" \
      > "$tmpdir/status"
    then
      die "Signature verification failed!"
    fi

    # Verify the signer's primary-key fingerprint.
    # Require exactly one valid signature from our expected key.
    if ! awk -v expected="$expected" '
      $1 == "[GNUPG:]" && $2 == "VALIDSIG" {
        count++
        # Last field is the primary-key fingerprint.
        # Fall back to signing-key fingerprint if absent.
        primary = (NF >= 12 ? $12 : $3)
        if (primary != expected)
          mismatch = 1
      }
      END {
        if (count != 1 || mismatch)
          exit 1
      }
      ' "$tmpdir/status"
    then
      die "Signature signer mismatch!"
    fi

    say "Signature verified with expected key: $expected"
  )


