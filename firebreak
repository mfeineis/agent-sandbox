#!/bin/sh

cli() {
  set -eu

  SBX_VERSION="0.2.4"
  SBX_BUILD=50
  SBX_STORE="firebreak"
  SBX_CONF_FILE="firebreak.conf"
  SBX_CLI_VERSION="$SBX_VERSION"

  print_usage() {
    echo "$0 $SBX_CLI_VERSION usage - easy isolated sandboxes" >&2
    echo "    config init ........................ Check dependencies and initialize configuration" >&2
    echo "    config upgrade ..................... Check dependencies and upgrade configuration" >&2
    echo "    <sandbox> create ................... Create a named sandbox" >&2
    echo "    <sandbox> up ....................... Run sandbox and connect local docker socket" >&2
    echo "    <sandbox> snapshot <name> create ... Create named snapshot" >&2
    echo "    <sandbox> snapshot <name> restore .. Restore sandbox to a named snapshot state" >&2
    echo "    <sandbox> snapshot <name> delete ... Delete a named snapshot" >&2
    echo "    <sandbox> snapshot --list .......... List snapshots of sandbox" >&2
    echo "    <sandbox> reset .................... Reset a sandbox to its fresh setup state" >&2
    echo "    <sandbox> delete ................... Delete a sandbox" >&2
    echo "    --list ............................. List all local sandboxes" >&2
    echo "    --version .......................... Return the tool version" >&2
    echo "    --help ............................. Display this help page" >&2
    exit 1
  }

  SBX_TRACING=""
  SBX_OWNER="mfeineis"
  SBX_OWNER_REPO="agent-sandbox"

  SBX_GIT_SERVER_VERSION="16.0.1-rootless"
  SBX_GIT_SERVER_PORT=3000
  SBX_GIT_USER="Claude Code"
  SBX_GIT_EMAIL="claude@agent.sandbox"

  SBX_AGENT_DEVCON_FEATURE=claude-code
  SBX_AGENT_NPM_PACKAGE="@anthropic-ai/claude-code"
  SBX_AGENT_VERSION="2.1.220" # stable

  SBX_OCI_REGISTRY_MIRRORS=${SBX_OCI_REGISTRY_MIRRORS:-""}

  SBX_UI_SPINNER_STYLE="braille" # ascii
  SBX_UI_SPINNER_DELAY=0.1 # non-POSIX sub-second spinner delay

  panic() {
    status=$(($1 + 0))
    shift
    echo "$@" >&2
    exit $status
  }

  info() {
    echo "$@"
  }

  trace() {
    if [ -z "$SBX_TRACING" ]; then
      true
    else
      echo "[TRACE]:" "$@"
    fi
  }

  require() {
    if ! command -v "$1" >/dev/null 2>&1; then
      panic 2 "Missing dependency" "$@"
    fi
  }

  OS="$(uname -s)"
  ARCH="$(uname -m)"
  # QEMU_MACHINE=""
  # QEMU_BOOT_DISK_ARGS=""
  case "$ARCH" in
    x86_64)
      ALPINE_FIRMWARE=${ALPINE_FIRMWARE:-bios}
    ;;
    aarch64|arm64)
      ARCH="aarch64"
      # QEMU_MACHINE="-machine virt" # arm64 qemu machine
      ALPINE_FIRMWARE=${ALPINE_FIRMWARE:-uefi}
      # QEMU_BOOT_DISK_ARGS="-bios QEMU_EFI.fd"
      # QEMU_BOOT_DISK_ARGS="-drive if=pflash,format=raw,file=${FIRMWARE_PATH}"
    ;;
    *) panic 11 "Unsupported architecture: $ARCH" ;;
  esac
  ALPINE_ARCH="$ARCH"
  QEMU_SYSTEM="qemu-system-$ARCH"
  if [ "$OS" != "Darwin" ]; then
    panic 10 "Unsupported OS $OS"
  fi

  ALPINE_MIRROR="${ALPINE_MIRROR:-https://dl-cdn.alpinelinux.org/alpine}"
  ALPINE_RELEASE="${ALPINE_RELEASE:-v3.24}"
  ALPINE_VERSION="${ALPINE_VERSION:-3.24.1}"
  ALPINE_ARCH="${ALPINE_ARCH:-x86_64}"
  # ALPINE_FIRMWARE="${ALPINE_FIRMWARE:-uefi}" # bios or uefi
  ALPINE_REVISION="${ALPINE_REVISION:-r0}"

  # require squid
  require echo
  require printf
  require cut
  require awk
  require sed
  require sort
  require tail
  require grep
  require cp
  require rm
  require wc
  require sha256sum
  require sha512sum
  require gpg ", install i.e. via 'brew install gnupg'"
  require curl
  require ssh
  require ssh-keygen
  require qemu-img ", install i.e. via 'brew install qemu'"
  require "$QEMU_SYSTEM" ", install i.e. via 'brew install qemu'"

  npm_latest() {
    package="$1"

    if command -v jq >/dev/null 2>&1; then
      encoded=$(
        printf '%s' "$package" |
          sed 's/%/%25/g; s/@/%40/g; s|/|%2F|g'
      )
      curl -fsSL \
          "https://registry.npmjs.org/$encoded/latest" |
          jq -r '.version'
    else
      encoded=$(
        printf '%s' "$package" |
          sed 's/%/%25/g; s/@/%40/g; s|/|%2F|g'
      ) || return

      curl -fsSL \
        "https://registry.npmjs.org/$encoded/latest" |
        sed -n 's/.*"version":"\([^"]*\)".*/\1/p'
    fi
  }

  cmd_config_apply() {
    ALPINE_SERIES=$(
      printf '%s\n' "$ALPINE_VERSION" |
        awk -F. '{ print "v" $1 "." $2 }'
    )
    ALPINE_IMAGE_NAME="generic_alpine-${ALPINE_VERSION}-${ALPINE_ARCH}-${ALPINE_FIRMWARE}-cloudinit-${ALPINE_REVISION}.qcow2"
    INDEX_URL="${ALPINE_MIRROR}/${ALPINE_SERIES}/releases/cloud/"
    ALPINE_IMAGE_URL="${INDEX_URL}${ALPINE_IMAGE_NAME}"
    ALPINE_SIGNATURE_URL="${ALPINE_IMAGE_URL}.asc"
  }

  cmd_config_upgrade() {
    set -u
    if [ -n "$ALPINE_VERSION" ]; then
      if ! printf '%s\n' "$ALPINE_VERSION" |
        grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
      then
        panic 1 "Invalid Alpine version: $ALPINE_VERSION"
      fi

      ALPINE_SERIES=$(
        printf '%s\n' "$ALPINE_VERSION" |
          awk -F. '{ print "v" $1 "." $2 }'
      )

      MATCH_VERSION="$ALPINE_VERSION"
    else
      ALPINE_SERIES="latest-stable"
      MATCH_VERSION='[0-9]+\.[0-9]+\.[0-9]+'
    fi

    INDEX_URL="${ALPINE_MIRROR}/${ALPINE_SERIES}/releases/cloud/"
    MATCH_RE="^generic_alpine-${MATCH_VERSION}-${ALPINE_ARCH}-${ALPINE_FIRMWARE}-cloudinit-r[0-9]+\\.qcow2$"
    ALPINE_IMAGE_NAME=$(
      curl -fsSL "$INDEX_URL" |
        sed -n 's|.*href="\([^"]*\.qcow2\)".*|\1|p' |
        grep -E "$MATCH_RE" |
        sed -n "
            s|^generic_alpine-\([0-9][0-9]*\)\.\([0-9][0-9]*\)\.\([0-9][0-9]*\)-${ALPINE_ARCH}-${ALPINE_FIRMWARE}-cloudinit-r\([0-9][0-9]*\)\.qcow2$|\1 \2 \3 \4 &|p
        " |
        sort -k1,1n -k2,2n -k3,3n -k4,4n |
        tail -n 1 |
        cut -d ' ' -f 5-
    )

    if [ -z "$ALPINE_IMAGE_NAME" ]; then
      panic 1 "No matching Alpine cloud image found at:\n  $INDEX_URL"
    fi

    ALPINE_IMAGE_URL="${INDEX_URL}${ALPINE_IMAGE_NAME}"
    # ALPINE_CHECKSUM_URL="${ALPINE_IMAGE_URL}.sha512"
    ALPINE_SIGNATURE_URL="${ALPINE_IMAGE_URL}.asc"
    set +u

    SBX_AGENT_NPM_LATEST=$(npm_latest $SBX_AGENT_NPM_PACKAGE)
    SBX_AGENT_VERSION=${SBX_AGENT_NPM_LATEST:-SBX_AGENT_VERSION}
  }

  write_conf() {
    trace "call write_conf"
    {
      echo "# $SBX_STORE conf"
      echo "alpine_version=$ALPINE_VERSION"
      echo
      echo "# User settings"
      echo "git_user=$SBX_GIT_USER"
      echo "git_email=$SBX_GIT_EMAIL"
      echo "claude_code_version=$SBX_AGENT_VERSION"
    } >"$PWD/$SBX_CONF_FILE"
    trace "return write_conf"
  }

  trace_conf() {
    set +u
    trace "ALPINE_VERSION ..........." "$ALPINE_VERSION"
    trace "ALPINE_IMAGE_NAME ........" "$ALPINE_IMAGE_NAME"
    trace "SBX_VERSION .............." "$SBX_VERSION"
    trace "SBX_OWNER ................" "$SBX_OWNER"
    trace "SBX_OWNER_REPO ..........." "$SBX_OWNER_REPO"
    trace "SBX_GIT_SERVER_VERSION ..." "$SBX_GIT_SERVER_VERSION"
    trace "SBX_GIT_SERVER_PORT ......" "$SBX_GIT_SERVER_PORT"
    trace "SBX_GIT_USER ............." "$SBX_GIT_USER"
    trace "SBX_GIT_EMAIL ............" "$SBX_GIT_EMAIL"
    trace "SBX_AGENT_DEVCON_FEATURE ." "$SBX_AGENT_DEVCON_FEATURE"
    trace "SBX_AGENT_VERSION ........" "$SBX_AGENT_VERSION"
    set -u
  }

  # We only support allow-lists
  read_conf() {
    if [ -f "$PWD/$SBX_CONF_FILE" ]; then
      while IFS='=' read -r key val || [ -n "$key" ]; do
        # Strip leading/trailing whitespace
        key=$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        val=$(echo "$val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

        # Skip empty lines or lines starting with '#'
        case "$key" in
          '#'* | '') continue ;;
        esac

        case "$key" in
          tracing) SBX_TRACING="$val" ;;
          alpine_version) ALPINE_VERSION="$val" ;;
          owner) SBX_OWNER="$val" ;;
          owner_repo) SBX_OWNER_REPO="$val" ;;
          git_server_version) SBX_GIT_SERVER_VERSION="$val" ;;
          git_server_port) SBX_GIT_SERVER_PORT="$val" ;;
          git_user) SBX_GIT_USER="$val" ;;
          git_email) SBX_GIT_EMAIL="$val" ;;
          claude_code_version) SBX_AGENT_VERSION="$val" ;;
          *) echo "Warning: Unknown option '$key' in $SBX_CONF_FILE" >&2 ;;
        esac
      done < "$PWD/$SBX_CONF_FILE"
      cmd_config_apply
    fi
    if [ -f "$PWD/.env" ]; then
      while IFS='=' read -r key val || [ -n "$key" ]; do
        # Strip leading/trailing whitespace
        key=$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        val=$(echo "$val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

        # Skip empty lines or lines starting with '#'
        case "$key" in
          '#'* | '') continue ;;
        esac

        case "$key" in
          SBX_OCI_REGISTRY_MIRRORS)
            # ENV variables override .env settings
            if [ -z "$SBX_OCI_REGISTRY_MIRRORS" ]; then
              SBX_OCI_REGISTRY_MIRRORS="$val"
            fi
          ;;
          *) ;;
        esac
      done < "$PWD/.env"
      cmd_config_apply
    fi
    trace_conf
  }

  read_conf "$@"

  DEVCON_STORE=".devcontainer"
  # WORKDIR=${FIREBREAK_WORKDIR:-"$DEVCON_STORE/firebreak"}
  # TMPDIR=${FIREBREAK_TMPDIR:-".devcontainer/firebreak/tmp"}
  STORE="$DEVCON_STORE/$SBX_STORE"
  STORE_IMG="$STORE/img"
  STORE_SSH="$STORE/ssh"
  STORE_SHARED="$STORE/shared"
  STORE_VM="$STORE/vm"

  FIRMWARE_VERSION="${FIRMWARE_VERSION:-firmware-v202605-edk2-stable}"
  FIRMWARE_URL="${FIRMWARE_URL:-https://github.com/${SBX_OWNER}/${SBX_OWNER_REPO}/releases/download/${FIRMWARE_VERSION}/QEMU_EFI.fd}"
  FIRMWARE_SHA256="${FIRMWARE_SHA256:-17013c4f9b1f640685c0f0ad24a32d63b8e63a0fb30f33e61e4f6c3abffc65df}"

  # CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/qemu-aarch64-firmware"
  # CACHE_DIR="${STORE}/img"
  FIRMWARE_PATH="${STORE_IMG}/${FIRMWARE_VERSION}-QEMU_EFI.fd"
  # VM_DIR="${VM_DIR:-${PWD}/.vm-aarch64}"
  # VM_DISK="${VM_DIR}/disk.qcow2"
  # [ "${FIRMWARE_SHA256}" =~ ^[0-9a-fA-F]{64}$ ] ||
  #   die "set FIRMWARE_SHA256 to the workflow's QEMU_EFI.fd hash"
  # mkdir -p "${CACHE_DIR}" "${VM_DIR}"

  file_size_mb() {
    bytes=$(wc -c < "$1")
    mib=$(( (bytes + 1048575) / 1048576 ))
    printf "%s" $mib
  }

  mac_addr_from_string() {
    s="$1"

    if command -v sha256sum >/dev/null 2>&1; then
      h=$(printf '%s' "$s" | sha256sum | awk '{print $1}')
    else
      h=$(printf '%s' "$s" | shasum -a 256 | awk '{print $1}')
    fi

    printf '52:54:00:%s:%s:%s\n' \
      "$(printf '%s' "$h" | cut -c1-2)" \
      "$(printf '%s' "$h" | cut -c3-4)" \
      "$(printf '%s' "$h" | cut -c5-6)"
  }

  spinner_frame() {
    case ${SBX_UI_SPINNER_STYLE-ascii} in
      braille)
        case $(($1 % 10)) in
          0) printf '%s' '⠋' ;;
          1) printf '%s' '⠙' ;;
          2) printf '%s' '⠹' ;;
          3) printf '%s' '⠸' ;;
          4) printf '%s' '⠼' ;;
          5) printf '%s' '⠴' ;;
          6) printf '%s' '⠦' ;;
          7) printf '%s' '⠧' ;;
          8) printf '%s' '⠇' ;;
          9) printf '%s' '⠏' ;;
        esac
        ;;
      *)
        case $(($1 % 4)) in
          0) printf '%s' '|' ;;
          1) printf '%s' '/' ;;
          2) printf '%s' '-' ;;
          3) printf '%s' '\' ;;
        esac
        ;;
    esac
  }

  osc_progress() {
    # osc_progress 1 10
    # 0  inactive
    # 1  progressing
    # 2  error
    # 3  indeterminate
    # 4  paused
    esc=$(printf '\033')

    if [ "$#" -eq 1 ]; then
      # State without a percentage.
      printf '%s]9;4;%s%s\\' "$esc" "$1" "$esc"
    else
      printf '%s]9;4;%s;%s%s\\' "$esc" "$1" "$2" "$esc"
    fi
  }

  run_with_spinner() {
    # Do not emit terminal animation when stderr is redirected.
    if [ ! -t 2 ]; then
      "$@"
      return $?
    fi

    (
      "$@" &
      command_pid=$!

      (
        trap 'exit 0' HUP INT TERM
        osc_progress 3

        frame_number=0
        while :; do
          frame=$(spinner_frame "$frame_number")
          printf '\r%s Please stand by...' "$frame" >&2
          frame_number=$((frame_number + 1))

          # POSIX sleep only guarantees whole seconds.
          sleep "${SBX_UI_SPINNER_DELAY-1}"
        done
      ) &
      spinner_pid=$!

      wait "$command_pid"
      command_status=$?

      kill "$spinner_pid" 2>/dev/null
      wait "$spinner_pid" 2>/dev/null

      # Overwrite the previous indicator.
      printf '\r%-40s\r' '' >&2

      if [ "$command_status" -eq 0 ]; then
        printf '[ok] Complete\n' >&2
      else
        printf '[!!] Failed with status %d\n' \
          "$command_status" >&2
      fi

      osc_progress 0
      exit "$command_status"
    )
  }

  progress() {
    progress_done=$1
    progress_total=$2
    progress_width=${3-30}

    [ "$progress_total" -gt 0 ] || return 2

    [ "$progress_done" -lt 0 ] &&
      progress_done=0

    [ "$progress_done" -gt "$progress_total" ] &&
      progress_done=$progress_total

    progress_filled=$(
      printf '%d\n' \
        "$((progress_done * progress_width / progress_total))"
    )
    progress_empty=$((progress_width - progress_filled))
    progress_percent=$((progress_done * 100 / progress_total))

    printf '\r[' >&2

    progress_i=0
    while [ "$progress_i" -lt "$progress_filled" ]; do
      osc_progress $(($progress_percent))
      printf '#' >&2
      progress_i=$((progress_i + 1))
    done

    progress_i=0
    while [ "$progress_i" -lt "$progress_empty" ]; do
      printf ' ' >&2
      progress_i=$((progress_i + 1))
    done

    printf '] %3d%%' "$progress_percent" >&2

    if [ "$progress_done" -eq "$progress_total" ]; then
      osc_progress 0
      printf '\n' >&2
    fi
  }

  progress_sample() {
    i=0

    while [ "$i" -le 100 ]; do
      progress "$i" 100 25

      # Do one unit of real work here.
      sleep 1

      i=$((i + 10))
    done
  }

  cmd_create() {
    set -eu
    SBX_NAME="$1"

    # TODO: custom project-owned docker socket
    # TODO: docker context setup
    # TODO: setup vscode settings
    # TODO: setup IntelliJ settings

    mkdir -p "${STORE_VM}"
    mkdir -p "${STORE_SHARED}"
    mkdir -p "${STORE_IMG}"

    mkdir -p "${STORE_SSH}"
    # from="127.0.0.1,::1",restrict,command="/usr/local/bin/local-task" ssh-ed25519 ...
    chmod 700 "${STORE_SSH}"
    {
      printf '[127.0.0.1]:2222 '
      cat "$STORE_SSH/id_ed25519_guest.pub"
    } >> "$STORE_SSH/known_hosts"
    chmod 600 "${STORE_SSH}/*"
    chmod 644 "${STORE_SSH}/*.pub"

    # IMAGE_NAME="generic_alpine-${ALPINE_VERSION}-${ALPINE_ARCH}-${ALPINE_FIRMWARE}-cloudinit-${ALPINE_REVISION}.qcow2"
    # BASE_URL="https://dl-cdn.alpinelinux.org/alpine/${ALPINE_RELEASE}/releases/cloud"

    # ALPINE_IMAGE_URL="${BASE_URL}/${IMAGE_NAME}"
    # SHA512_URL="${IMAGE_URL}.sha512"
    # ASC_URL="${ALPINE_IMAGE_URL}.asc"

    ALPINE_IMAGE_PATH="${STORE_IMG}/${ALPINE_IMAGE_NAME}"
    # SHA512_PATH="${IMAGE_PATH}.sha512"
    # ASC_PATH="${IMAGE_PATH}.asc"
    ALPINE_SIGNATURE_PATH="${ALPINE_IMAGE_PATH}.asc"

    if [ -f "${ALPINE_IMAGE_PATH}" ]; then
      info "Baseimage already present, skipping download."
    else
      info "Downloading baseimage:"
      info "  $ALPINE_IMAGE_URL"

      curl -fL --progress-bar "$ALPINE_IMAGE_URL" -o "${ALPINE_IMAGE_PATH}.part"
      mv "${ALPINE_IMAGE_PATH}.part" "$ALPINE_IMAGE_PATH"

      info "Downloading detached GPG signature:"
      info "  $ALPINE_SIGNATURE_URL"

      if curl -fL --progress-bar "$ALPINE_SIGNATURE_URL" -o "${ALPINE_SIGNATURE_PATH}.part"; then
        mv "${ALPINE_SIGNATURE_PATH}.part" "$ALPINE_SIGNATURE_PATH"
        info "Signature downloaded. Verify with your trusted Alpine signing key:"
        info "  gpg --verify '$ALPINE_SIGNATURE_PATH' '$ALPINE_IMAGE_PATH'"
      else
        rm -f "${ALPINE_SIGNATURE_PATH}.part"
        info "No .asc signature downloaded; continuing after SHA512 verification."
      fi
    fi

    info "Ready:"
    SZ=$(file_size_mb "${ALPINE_IMAGE_PATH}")
    info "  [${SZ}MiB] $ALPINE_IMAGE_PATH"

    SBX_PATH="${STORE_VM}/${SBX_NAME}.qcow2"
    if [ -f "${SBX_PATH}" ]; then
      info "Sandbox '${SBX_NAME}' already present, skipping creation."
    else
      qemu-img convert -O qcow2 "${ALPINE_IMAGE_PATH}" "${SBX_PATH}"
      qemu-img resize "${SBX_PATH}" 60G
      qemu-img snapshot -c "base" "${SBX_PATH}"
    fi

    SZ=$(file_size_mb "${SBX_PATH}")
    info "  [${SZ}MiB] $SBX_PATH"

    if [ "$ALPINE_FIRMWARE" = "uefi" ]; then
      info "Procuring UEFI firmware image..."

      verify_firmware() {
        printf '%s  %s\n' "${FIRMWARE_SHA256}" "${FIRMWARE_PATH}" |
          sha256sum -c - >/dev/null 2>&1
      }

      if [ ! -f "${FIRMWARE_PATH}" ] || ! verify_firmware; then
        temporary="${FIRMWARE_PATH}.download"
        rm -f "${temporary}"

        printf '  Downloading pinned UEFI firmware...\n'
        curl \
          --fail \
          --location \
          --proto '=https' \
          --tlsv1.2 \
          --output "${temporary}" \
          "${FIRMWARE_URL}"

        printf '%s  %s\n' "${FIRMWARE_SHA256}" "${temporary}" |
          sha256sum -c - >/dev/null 2>&1 ||
          panic 12 "firmware checksum verification failed"

        mv "${temporary}" "${FIRMWARE_PATH}"
      else
        info "  Firmware already present, skipping download."
      fi
      info "Finished procuring UEFI firmware image. Available at ${FIRMWARE_PATH}, copying into scope..."
      cp "${FIRMWARE_PATH}" "${PWD}/QEMU_EFI.fd"
      info "Done."
    fi
  }

  cmd_reset() {
    set -eu
    qemu-img snapshot -a "base" "${STORE_VM}/$1.qcow2"
    exec "$QEMU_SYSTEM" \
      -machine virt -cpu host -accel hvf \
      -bios QEMU_EFI.fd \
      \
      -name "agent-sandbox" \
      -m 10240 -smp 4 \
      \
      -object iothread,id=io_os \
      -device virtio-scsi-pci,id=scsi_os,iothread=io_os,num_queues=1 \
      -blockdev "driver=file,node-name=osfile,filename=${STORE_VM}/$1.qcow2,aio=threads" \
      -blockdev "driver=qcow2,node-name=osdisk,file=osfile,read-only=off" \
      -device scsi-hd,drive=osdisk,bus=scsi_os.0,channel=0,scsi-id=0,lun=0,bootindex=1 \
      \
      -blockdev "driver=vvfat,node-name=cidata,dir=${STORE}/cloud-init,label=CIDATA,read-only=on" \
      -device scsi-hd,drive=cidata,bus=scsi_os.0,channel=0,scsi-id=1,lun=0 \
      \
      -virtfs "local,path=${STORE_SHARED},mount_tag=shared,security_model=mapped-xattr,id=shared,readonly=on" \
      \
      -netdev user,id=net0,ipv6=off,net=10.0.2.0/24,dhcpstart=10.0.2.15,hostfwd=tcp:127.0.0.1:2222-:22 \
      -device virtio-net-pci,netdev=net0,mac=52:54:00:12:34:56 \
      -chardev socket,path="${STORE}/qga.sock",server=on,wait=off,id=qga0 \
      -device virtio-serial-pci \
      -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0 \
      -device qemu-xhci -device usb-kbd -device usb-tablet \
      -k en-us \
      -device virtio-gpu-pci \
      -serial mon:stdio
    # -serial "file:${STORE}/local/serial.log" \
    # -nographic \
  }

  cmd_run_vm() {
    set -eu
    exec "$QEMU_SYSTEM" \
      -machine virt -cpu host -accel hvf \
      -bios QEMU_EFI.fd \
      \
      -name "agent-sandbox" \
      -m 10240 -smp 4 \
      \
      -object iothread,id=io_os \
      -device virtio-scsi-pci,id=scsi_os,iothread=io_os,num_queues=1 \
      -blockdev "driver=file,node-name=osfile,filename=${STORE_VM}/$1.qcow2,aio=threads" \
      -blockdev "driver=qcow2,node-name=osdisk,file=osfile,read-only=off" \
      -device scsi-hd,drive=osdisk,bus=scsi_os.0,channel=0,scsi-id=0,lun=0,bootindex=1 \
      \
      -blockdev "driver=vvfat,node-name=cidata,dir=${STORE}/cloud-init,label=CIDATA,read-only=on" \
