snapshot_vm() {
  operation=$1
  [ -f "$DISK" ] || die 'Sandbox disk does not exist'
  [ ! -d "$DISK.lock" ] || die 'Stop sandbox before snapshots; disk is locked'
  need qemu-img qemu
  if [ "$operation" = --list ]; then qemu-img snapshot -l "$DISK"; return; fi
  label=$operation; action=${2:-}
  valid_name "$label" || die 'Invalid snapshot name'
  case $action in create|-c) flag=-c;; restore|-a) flag=-a;; delete|-d) flag=-d;; *) die 'Use snapshot NAME create|restore|delete';; esac
  qemu-img snapshot "$flag" "$label" "$DISK"
  if [ "$action" = restore ]; then
    rm -f "$SYNC_DIR/host-base" "$SYNC_DIR/guest-base"
    if [ "$label" = base ]; then
      rm -f "$SECRET/provisioned"
      say 'Restored pristine base; run unsafe and complete initial provisioning before up.'
    else
      say 'Snapshot restored; any pending Git sync was invalidated.'
    fi
  fi
}

delete_vm() {
  [ -f "$DISK" ] || die "Sandbox $NAME does not exist"
  [ ! -d "$DISK.lock" ] || die 'Stop sandbox before deletion'
  # Explicit name, explicit disk. Do NOT erase shared image cache or secrets.
  rm -f "$DISK" "$SYNC_DIR/host-base" "$SYNC_DIR/guest-base"
  say "Deleted disk $DISK (SSH and Forgejo secrets preserved)"
}

# A host-side export never sends .git, host remotes, or credential configuration.
# Git bundles are used in the other direction, avoiding unsafe guest tar extraction.
git_host() { git -C "$ROOT" "$@"; }
ssh_checked() {
  [ -f "$DISK" ] || die 'Missing VM disk'
  ssh_vm true </dev/null >/dev/null 2>&1 || die "Start '$0 $NAME up' or unsafe first"
}
make_snapshot_repo() {
  export_dir=$1 history=$2 depth=$3
  mkdir -p "$export_dir/repo"
  case $history in
    full)
      # A normal clone includes the real repository history and checked-out HEAD.
      rmdir "$export_dir/repo"
      git clone -q --no-local "$ROOT" "$export_dir/repo" || die 'Unable to clone host repository'
      git -C "$export_dir/repo" checkout -q -B main "$(git_host rev-parse HEAD)"
      ;;
    snapshot|shallow)
      git -C "$export_dir/repo" init -q
      if [ "$history" = snapshot ]; then
        commits=$(git_host rev-parse HEAD) || die 'Git repository requires HEAD'
      else
        commits=$(git_host rev-list --max-count="$depth" HEAD | sed '1!G;h;$!d')
      fi
      # In shallow mode recreate the last N commit *trees* as a new linear history.
      # This intentionally does not import earlier parents, tags, or remotes.
      for commit in $commits; do
        for path in "$export_dir/repo"/* "$export_dir/repo"/.[!.]* "$export_dir/repo"/..?*; do
          [ -e "$path" ] || [ -L "$path" ] || continue
          [ "${path##*/}" = .git ] || rm -rf "$path"
        done
        git_host archive "$commit" | tar -xf - -C "$export_dir/repo"
        if [ "$history" = shallow ]; then
          git -C "$export_dir/repo" add -A
          git -C "$export_dir/repo" -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" \
            commit -q --allow-empty -m "$(git_host log -1 --format=%s "$commit")"
        fi
      done
      ;;
    *) die 'Unsupported history policy';;
  esac
  # Incorporate modifications to TRACKED host files; no untracked files.
  git_host diff --binary HEAD > "$export_dir/working.patch"
  if [ -s "$export_dir/working.patch" ]; then
    git -C "$export_dir/repo" apply "$export_dir/working.patch" || die 'Could not apply tracked working tree changes'
  fi
  if [ "$history" = snapshot ]; then
    git -C "$export_dir/repo" add -A
    git -C "$export_dir/repo" -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" \
      commit -q --allow-empty -m 'Initial tracked workspace snapshot'
  elif [ -s "$export_dir/working.patch" ]; then
    git -C "$export_dir/repo" add -A
    git -C "$export_dir/repo" -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" \
      commit -q --allow-empty -m 'Uncommitted tracked host changes'
  fi
  git -C "$export_dir/repo" branch -q -M main
  git -C "$export_dir/repo" bundle create "$export_dir/import.bundle" refs/heads/main
}

# This command is SSH-side, not user-supplied code. The only interpolation is a
# previously validated sandbox name, fixed repository name, and generated hex.
guest_import_cmd() {
  printf 'REPLACE=%s\n' "$replace"
  cat <<'EOF_GUEST'
set -eu
umask 077
mkdir -p /var/lib/firebreak/workspaces/default
cd /var/lib/firebreak/workspaces/default
if [ ! -d .git ]; then git init -q; fi
# The bundle has already been transferred in a separate SSH invocation.
# Refuse to erase uncommitted work or an existing imported history by default.
git diff --quiet && git diff --cached --quiet || exit 11
if git remote get-url origin >/dev/null 2>&1 && [ "$REPLACE" != yes ]; then
  echo 'Existing Forgejo workspace; pull first, then push --replace if desired' >&2
  exit 13
fi
git fetch -q /var/lib/firebreak/incoming.bundle refs/heads/main
git checkout -q -B main FETCH_HEAD
# Create the Forgejo repository once, via the VM-local API.
code=$(curl -sS -o /dev/null -w '%{http_code}' -u "firebreak:$(cat /etc/firebreak/forgejo-password)" \
  http://127.0.0.1:3001/api/v1/repos/firebreak/workspace)
if [ "$code" = 404 ]; then
  curl -fsS -u "firebreak:$(cat /etc/firebreak/forgejo-password)" \
    -H 'Content-Type: application/json' -X POST \
    -d '{"name":"workspace","private":true,"default_branch":"main"}' \
    http://127.0.0.1:3001/api/v1/user/repos >/dev/null
elif [ "$code" != 200 ]; then
  echo "Forgejo repository lookup returned HTTP $code" >&2; exit 12
fi
if git remote get-url origin >/dev/null 2>&1; then git remote remove origin; fi
git remote add origin http://127.0.0.1:3001/firebreak/workspace.git
git config credential.helper 'store --file=/etc/firebreak/forgejo-credentials'
if [ "$REPLACE" = yes ]; then
  git push -q --force-with-lease -u origin main
else
  git push -q -u origin main
fi
rm -f /var/lib/firebreak/incoming.bundle
EOF_GUEST
}

sync_push() {
  history=$GIT_IMPORT depth=5 replace=no allow_sensitive=no
  for opt do case $opt in
    --history=*) history=${opt#*=};;
    --depth=*) depth=${opt#*=};;
    --replace) replace=yes;;
    --allow-sensitive-tracked) allow_sensitive=yes;;
    *) die "Unknown push option: $opt";;
  esac; done
  case $history in snapshot|shallow|full) :;; *) die 'Expected --history=snapshot|shallow|full';; esac
  case $depth in ''|*[!0-9]*) die 'depth must be integer';; esac
  [ "$depth" -ge 1 ] && [ "$depth" -le 50 ] || die 'depth must be 1..50'
  need git; need tar
  git_host rev-parse --verify HEAD >/dev/null 2>&1 || die 'Run push from a Git repository with at least one commit'
  if [ "$allow_sensitive" = no ]; then
    flagged=$(git_host ls-files -- '.env' '.env.*' '**/.env' '**/.env.*' '.npmrc' '**/.npmrc' '.pypirc' '**/.pypirc' '*.pem' '*.p12' '*.key' 2>/dev/null)
    [ -z "$flagged" ] || die 'Tracked files match common secret paths; inspect them and explicitly pass --allow-sensitive-tracked if intentional'
  fi
  ssh_checked
  mkdir -p "$SYNC_DIR" "$TMP"
  [ ! -f "$SYNC_DIR/host-base" ] || die 'Pending import exists: pull first or archive/remove the sync metadata intentionally'
  temp=$(mktemp -d "$TMP/export.XXXXXX") || die 'Cannot create temporary export'
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  make_snapshot_repo "$temp" "$history" "$depth"
  guestbase=$(git -C "$temp/repo" rev-parse HEAD)
  hostbase=$(git_host rev-parse HEAD)
  # Use two SSH calls: first send the bundle; then execute a fixed guest script.
  # No host Git remote URLs or authentication secrets are transmitted.
  ssh_vm 'umask 077; mkdir -p /var/lib/firebreak; cat > /var/lib/firebreak/incoming.bundle' < "$temp/import.bundle"
  guest_import_cmd | ssh_vm '/bin/sh -s' || die 'Guest import failed (existing guest commits may require pull first)'
  printf '%s\n' "$hostbase" > "$SYNC_DIR/host-base"
  printf '%s\n' "$guestbase" > "$SYNC_DIR/guest-base"
  say "Imported tracked files as $history history; guest baseline $guestbase"
}

create_review_branch() {
  bundle=$1 hostbase=$2 guestbase=$3
  git_host fetch -q "$bundle" 'refs/remotes/origin/main' || die 'Could not import sandbox bundle'
  guesttip=$(git_host rev-parse FETCH_HEAD)
  git_host cat-file -e "$guestbase^{commit}" 2>/dev/null || die 'Guest baseline is missing from fetched history'
  git_host merge-base --is-ancestor "$guestbase" "$guesttip" || die 'Guest history was rewritten; refusing unsafe sync'
  # Export the entire resulting tree relative to the original HOST commit.
  # This includes tracked-but-dirty files from the initial import.
  git_host diff --binary "$hostbase" "$guesttip" > "$temp/changes.patch"
  GIT_INDEX_FILE=$temp/index; export GIT_INDEX_FILE
  git_host read-tree "$hostbase"
  if [ -s "$temp/changes.patch" ]; then
    git_host apply --cached "$temp/changes.patch" || die 'Sandbox changes conflict with host baseline; review diff manually'
  fi
  tree=$(git_host write-tree)
  branch=firebreak/$NAME/$(printf '%s' "$guesttip" | cut -c1-12)
  if git_host show-ref --verify --quiet "refs/heads/$branch"; then die "Branch already exists: $branch"; fi
  commit=$(printf 'Import sandbox %s changes from %s\n' "$NAME" "$guesttip" | \
    git_host -c user.name="$GIT_USER" -c user.email="$GIT_EMAIL" commit-tree "$tree" -p "$hostbase")
  git_host update-ref "refs/heads/$branch" "$commit" '0000000000000000000000000000000000000000'
  say "Created host review branch $branch (host working tree untouched)."
}

sync_pull() {
  need git
  ssh_checked
  [ -f "$SYNC_DIR/host-base" ] && [ -f "$SYNC_DIR/guest-base" ] || die 'No recorded import: push first'
  hostbase=$(cat "$SYNC_DIR/host-base")
  guestbase=$(cat "$SYNC_DIR/guest-base")
  temp=$(mktemp -d "$TMP/pull.XXXXXX") || die 'Cannot create pull directory'
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  # Fetch the latest Forgejo main into the guest workspace; the host only gets
  # a verified Git bundle and never extracts guest-controlled tar archives.
  ssh_vm "git -C /var/lib/firebreak/workspaces/default fetch -q origin main && git -C /var/lib/firebreak/workspaces/default bundle create - refs/remotes/origin/main" > "$temp/return.bundle" || die 'Cannot export Forgejo repository'
  bundle=$temp/return.bundle
  create_review_branch "$bundle" "$hostbase" "$guestbase"
  rm -f "$SYNC_DIR/host-base" "$SYNC_DIR/guest-base"
}

doctor_vm() {
  say "Firebreak $VERSION, sandbox $NAME"
  say "  image: $(image_name)"
  say "  disk: $DISK"
  say "  exists: $(test -f "$DISK" && echo yes || echo no)"
  say "  provisioned: $(test -f "$SECRET/provisioned" && echo yes || echo no)"
  say "  locked: $(test -d "$DISK.lock" && echo yes || echo no)"
  say "  network_work: $NETWORK_WORK (QEMU restrict=on in all profiles)"
  say "  ssh port: $SSH_PORT; Forgejo: $FORGEJO_PORT"
  if [ -f "$SECRET/storage" ]; then say "  storage: $(cat "$SECRET/storage")"; fi
  if [ -f "$SEED/network-config" ]; then say "  seed MAC: $(grep macaddress "$SEED/network-config" | tr -d ' \"')"; fi
  if ssh_vm true </dev/null >/dev/null 2>&1; then
    say '  SSH: reachable'
    ssh_vm 'cloud-init status || true; rc-service forgejo status || true; rc-service podman status || true'
  else say '  SSH: not reachable (VM may be off)'; fi
}

self_test() {
  sh -n "$0" || die 'POSIX shell parser rejected firebreak'
  for mode in offline models unsafe; do
    args=$(net_args "$mode")
    case $args in *restrict=on*) :;; *) die "Unrestricted $mode policy";; esac
  done
  case $(net_args offline) in *10.0.2.100:3128*) die 'Offline mode exposes proxy';; esac
  valid_name valid-demo || die 'Name policy broke'
  if valid_name '../escape'; then die 'Traversal accepted'; fi
  say 'Built-in configuration and isolation-policy smoke checks passed.'
  config_cmd proxy-check
  # config_cmd proxy-check --online
    # proxy-check)
    #   case ${1:-} in ''|--online) :;; *) die 'proxy-check accepts only --online';; esac
}
main() {
  case ${1:-} in
    --self-test) self_test; exit 0;;
    --version) printf '%s\n' "$VERSION"; exit 0;;
    --help|-h|'') usage; exit 0;;
    --list)
      for img in "$VMS"/*.qcow2; do [ -f "$img" ] && printf '%s\n' "${img##*/}"; done
      exit 0;;
    config) shift; config_cmd "$@"; exit 0;;
  esac
  [ -f "$ROOT/$CONF" ] || die "Run '$0 config init' first"
  load
  [ "$#" -ge 2 ] || die 'Expected: firebreak NAME COMMAND'
  vm_paths "$1"
  cmd=$2; shift 2
  case $cmd in
    create) create_vm "$@";;
    unsafe) [ "$#" -eq 0 ] || die 'unsafe takes no arguments'; unsafe_vm;;
    unsafe-qemu) [ "$#" -eq 0 ] || die 'unsafe takes no arguments'; unsafe_qemu_vm;;
    # repair|provision) [ "$#" -eq 0 ] || die "$cmd takes no arguments"; provision_vm;;
    debug) [ "$#" -eq 0 ] || die 'debug takes no arguments'; debug_vm;;
    console-password) [ "$#" -eq 0 ] || die 'console-password takes no arguments'; console_password;;
    logs) show_logs "$@";;
    up) [ "$#" -eq 0 ] || die 'up takes no arguments'; up_vm;;
    sh) shell_env "$@";;
    snapshot) [ "$#" -ge 1 ] || die 'Specify a snapshot name'; snapshot_vm "$@";;
    push) sync_push "$@";;
    pull) [ "$#" -eq 0 ] || die 'pull takes no arguments'; sync_pull;;
    doctor) doctor_vm;;
    delete) delete_vm;;
    __test-runtime) [ "$#" -eq 1 ] || die 'Expected runtime profile'; runtime_for_profile "$1";;
    __test-net) [ "$#" -eq 1 ] || die 'Expected test mode'; net_args "$1";;
    __test-qemu)
      [ "$#" -eq 1 ] || die 'Expected serial mode'
      SERIAL_LOG=$TMP/$NAME.serial.log
      FIRMWARE=$IMAGES/test-firmware
      MAC=$(mac_from_string "$VERSION-$BUILD-$NAME")
      qemu_vm "$DISK" "$SEEDS/$NAME" "$MAC" unsafe "$1";;
    __test-render) render_seed "$NAME"; printf '%s\n' "$SEED";;
    __test-export)
      [ "$#" -eq 3 ] || die 'Expected DIRECTORY HISTORY DEPTH'
      make_snapshot_repo "$1" "$2" "$3";;
    __test-review)
      [ "$#" -eq 3 ] || die 'Expected BUNDLE HOST_BASE GUEST_BASE'
      temp=$(mktemp -d "$TMP/review.XXXXXX")
      trap 'rm -rf "$temp"' EXIT HUP INT TERM
      create_review_branch "$1" "$2" "$3";;
    *) die "Unknown command '$cmd'";;
  esac
}
main "$@"
