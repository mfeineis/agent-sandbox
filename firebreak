rc-update del podman default 2>/dev/null || :
mkdir -p /etc/containers/containers.conf.d /etc/containers/registries.conf.d /etc/firebreak /etc/profile.d
cat >/usr/local/bin/runsc-custom <<'EOF'
#!/bin/sh
EOF_APPLY
  printf 'exec /usr/local/bin/runsc --platform=systrap --overlay2=%s "$@"\n' "$OVERLAY"
  cat <<'EOF_APPLY'
EOF
chmod 755 /usr/local/bin/runsc-custom
policy_file=/etc/containers/containers.conf.d/99-firebreak-runsc.conf
policy_tmp=$(mktemp "${policy_file}.XXXXXX")
trap 'rm -f "$policy_tmp"' 0
trap 'exit 1' 1 2 3 15
{
  printf '[engine]\nruntime = "%s"\npull_policy = "%s"\n' "$selected_runtime" "$pull_policy"
  printf '[engine.runtimes]\nrunsc = ["/usr/local/bin/runsc-custom"]\ncrun = ["/usr/bin/crun"]\n'
} > "$policy_tmp"
if ! cmp -s "$policy_tmp" "$policy_file"; then
  mv -f "$policy_tmp" "$policy_file"
fi
# A default-runtime change does not migrate existing containers. In work mode,
# refuse to reuse unsafe-created crun containers: recreate them under runsc.
if [ "$profile" != unsafe ] && [ "$selected_runtime" = runsc ]; then
  podman ps -a --format '{{.ID}}' | while IFS= read -r container_id; do
    [ -n "$container_id" ] || continue
    original_runtime=$(podman container inspect --format '{{.OCIRuntime}}' "$container_id") || exit 1
    if [ "$original_runtime" != runsc ]; then
      printf 'Firebreak: container %s uses %s, expected runsc.\n' "$container_id" "$original_runtime" >&2
