  cmd_git_connect() {
    set -eu
    exec ssh -N \
      -l root \
      -p 2222 \
      -i "$STORE_SSH/id_ed25519_host" \
      -o "UserKnownHostsFile=$STORE_SSH/known_hosts" \
      -o StrictHostKeyChecking=yes \
      -o IdentitiesOnly=yes \
      -o ExitOnForwardFailure=yes \
      -o StreamLocalBindUnlink=yes \
      -L 3000:127.0.0.1:3000 \
      127.0.0.1
  }

  cmd_up() {
    set -eu

    vm_pid=
    git_ssh_pid=
    podman_ssh_pid=
    cleaning=0

    is_alive() {
      [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
    }

    stop_process() {
      pid="${1:-}"

      if is_alive "$pid"; then
        kill "$pid" 2>/dev/null || true
      fi
    }

    wait_for_exit() {
      pid=$1
      remaining=$2

      while is_alive "$pid" && [ "$remaining" -gt 0 ]; do
        sleep 1
        remaining=$((remaining - 1))
      done

      ! is_alive "$pid"
    }

    request_vm_shutdown() {
      printf '%s\n' "Requesting graceful VM shutdown..."

      ssh \
        -l root \
        -p 2222 \
        -i "$STORE_SSH/id_ed25519_host" \
        -o "UserKnownHostsFile=$STORE_SSH/known_hosts" \
        -o StrictHostKeyChecking=yes \
        -o BatchMode=yes \
        -o IdentitiesOnly=yes \
        -o ExitOnForwardFailure=yes \
        -o StreamLocalBindUnlink=yes \
        -o ConnectTimeout=5 \
        127.0.0.1 '/sbin/poweroff' \
        </dev/null
    }

    cleanup() {
      status=$?

      # Prevent recursive cleanup if a command below receives a signal.
      [ "$cleaning" -eq 0 ] || exit "$status"
      cleaning=1

      trap - EXIT INT TERM HUP

      if is_alive "$vm_pid"; then
        request_vm_shutdown 2>/dev/null || {
          printf '%s\n' \
            "Could not request shutdown over SSH." >&2
        }
      fi

      # Stop host-side tunnels. The guest shutdown request has already
      # been sent, so these are no longer needed.
      stop_process "$podman_ssh_pid"
      stop_process "$git_ssh_pid"

      if is_alive "$vm_pid"; then
        if ! wait_for_exit "$vm_pid" 30; then
          printf '%s\n' \
            "VM did not stop within 30 seconds; sending SIGTERM." >&2

          kill -TERM "$vm_pid" 2>/dev/null || true

          if ! wait_for_exit "$vm_pid" 5; then
            printf '%s\n' \
                "VM still running; sending SIGKILL." >&2
            kill -KILL "$vm_pid" 2>/dev/null || true
          fi
        fi
      fi

      # Reap children, suppressing their signal-related exit statuses.
      [ -z "$podman_ssh_pid" ] || wait "$podman_ssh_pid" 2>/dev/null || true
      [ -z "$git_ssh_pid" ] || wait "$git_ssh_pid" 2>/dev/null || true
      [ -z "$vm_pid" ] || wait "$vm_pid" 2>/dev/null || true

      exit "$status"
    }

    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    trap cleanup EXIT

    info "Warming up sandbox..."
    cmd_run_vm "$@" &
    vm_pid=$!

    run_with_spinner sleep 30 # alpine cloud waits for 10s to boot

    info "Exposing local git server..."
    cmd_git_connect "$@" &
    git_ssh_pid=$!

    info "Connecting to sandbox socket..."
    rm -f /tmp/agent-sandbox.sock \
    && ssh -N \
      -l root \
      -p 2222 \
      -i "$STORE_SSH"/id_ed25519_host \
      -o "UserKnownHostsFile=$STORE_SSH/known_hosts" \
      -o StrictHostKeyChecking=yes \
      -o IdentitiesOnly=yes \
      -o ExitOnForwardFailure=yes \
      -o StreamLocalBindUnlink=yes \
      -L /tmp/agent-sandbox.sock:/run/podman/podman.sock \
      127.0.0.1 &
    podman_ssh_pid=$!
      # -o StrictHostKeyChecking=accept-new \

    info "Sandbox ready."
    # Keep this command active until the primary tunnel exits or Ctrl+C
    # triggers the signal trap.
    wait "$podman_ssh_pid"
  }

  main() {
    set +u
    if [ "$1" = "--list" ]; then
      for img in "$STORE_VM"/*.qcow2
      do
        info "$img"
        info "[$(file_size_mb "${img}")MiB] $img"
      done
    elif [ "$1" = "--help" ]; then
      print_usage
    elif [ "$1" = "--version" ]; then
      echo "$SBX_CLI_VERSION"
    elif [ "$1" = "config" ]; then
      if [ -z "$2" ]; then
        info "No subcommand given for config command"
        print_usage
      fi
      case "$2" in
        init) cmd_config_upgrade "$@" && write_conf && migrate "$@" ;;
        upgrade) cmd_config_upgrade "$@" && write_conf ;;
        *) print_usage ;;
      esac
    else
      case "$2" in
        create)
          if [ -z "$1" ]; then
            panic 4 "No sandbox name given"
          fi
          cmd_create "$@" && cmd_reset "$@"
        ;;
        up)
          cmd_up "$@"
        ;;
        snapshot)
          if [ -z "$1" ]; then
            panic 4 "No name given"
          fi
          if [ "$3" = "--list" ]; then
            qemu-img snapshot -l "$STORE_VM/$1.qcow2"
          elif [ "$3" = "--help" ]; then
            print_usage
          else
            if [ -z "$4" ]; then
              panic 5 "No command given"
            fi
            case "$4" in
              create) qemu-img snapshot -c "$3" "$STORE_VM/$1.qcow2" ;;
              restore) qemu-img snapshot -a "$3" "$STORE_VM/$1.qcow2" ;;
              delete) qemu-img snapshot -d "$3" "$STORE_VM/$1.qcow2" ;;
              *) print_usage ;;
            esac
          fi
        ;;
        reset)
          if [ -z "$1" ]; then
            panic 4 "No sandbox name given"
          fi

          cmd_reset "$@"
        ;;
        delete)
          rm "$STORE_VM/$1.qcow2" && printf '%s' "$1"
        ;;
        *) print_usage ;;
      esac
    fi
    set -u
  }

