require() {
  _dep="$1"
  if ! command -v "$_dep" >/dev/null 2>&1; then
    case "${2:-}" in
      '') panic $EX_UNAVAILABLE "Missing dependency '$_dep' (try: $CLI_NAME config init --install-deps)" ;;
      *) panic $EX_UNAVAILABLE "Missing dependency '$_dep', part of package '$2' (try: $CLI_NAME config init --install-deps)" ;;
    esac
  fi
}

