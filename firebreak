# Docker CLI injects proxy build arguments; containers.conf alone does not
# reliably inject them into Podman builds invoked through the Docker API.
# Never use the user's global ~/.docker/config.json for Firebreak.
configure_docker_client() {
  [ -f "$ACTIVE_MODE" ] || die "Sandbox network profile unavailable: $ACTIVE_MODE"
  active_mode=$(cat "$ACTIVE_MODE") || die 'Cannot read sandbox network profile'
  case $active_mode in
    unsafe)
      cli_mode=unsafe
      ;;
    offline|models)
      cli_mode=work
      ;;
    *) die "Unexpected sandbox network profile: $active_mode" ;;
  esac
  cli_dir=$STORE/docker/$NAME/$cli_mode
  mkdir -p "$cli_dir"
  if [ "$cli_mode" = unsafe ]; then
    cat <<'EOF_DOCKER_PROXY' | write_if_changed "$cli_dir/config.json"
{
  "proxies": {
    "default": {
      "httpProxy": "http://10.0.2.100:3128",
      "httpsProxy": "http://10.0.2.100:3128"
    }
  }
}
EOF_DOCKER_PROXY
  else
    printf '{}\n' | write_if_changed "$cli_dir/config.json"
  fi
  # Keep Compose/Buildx available without sharing Docker credentials or auths.
  if [ -n "${HOME:-}" ] && [ -d "$HOME/.docker/cli-plugins" ] && \
     [ ! -e "$cli_dir/cli-plugins" ] && [ ! -L "$cli_dir/cli-plugins" ]; then
    ln -s "$HOME/.docker/cli-plugins" "$cli_dir/cli-plugins"
  fi
  export DOCKER_CONFIG="$cli_dir"
}

