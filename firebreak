image_name() {
  printf 'generic_alpine-%s-aarch64-uefi-cloudinit-%s.qcow2' "$ALPINE_VERSION" "$ALPINE_REVISION"
}

image_url() {
  series=$(printf '%s' "$ALPINE_VERSION" | awk -F. '{print "v" $1 "." $2}')
  printf '%s/%s/releases/cloud/%s' "${ALPINE_MIRROR%/}" "$series" "$(image_name)"
}

require_host() {
  [ "$(uname -s)" = Darwin ] || panic $EX_OSERR 'VM commands require macOS; config generation and tests also work on Linux'
  case $(uname -m) in
    arm64|aarch64) : ;;
    *) panic $EX_OSERR 'Only Apple Silicon supported in this release' ;;
  esac
  require qemu-system-aarch64 qemu
  require qemu-img qemu
  require ssh
  require socat
}

# A standalone, repeatable guest bootstrap. The exact same bytes are embedded
# in cloud-init and retained on the host for SSH repair after a failed first boot.
render_gvisor_install() {
  cat <<'EOF_GVISOR'
#!/bin/sh
set -eu
umask 077

ARCH=$(uname -m)
URL=https://storage.googleapis.com/gvisor/releases/release/latest/${ARCH}
PROXY=http://10.0.2.100:3128
WORK=$(mktemp -d /tmp/firebreak-gvisor.XXXXXX)
trap 'rm -rf "$WORK"' EXIT HUP INT TERM
cd "$WORK"

# apk installed curl in the preceding packages script. Explicit proxy and
# --fail/--show-error expose Squid HTTP denials instead of BusyBox wget's
# unhelpful "error getting response". No direct-network fallback is allowed.
command -v curl >/dev/null 2>&1 || { echo 'gVisor: curl missing; packages stage failed' >&2; exit 1; }
for file in gvisor.tar.bz2 gvisor.tar.bz2.sha512; do
  echo "gVisor: downloading $file via setup proxy" >&2
  curl --fail --show-error --silent --location \
    --retry 3 --retry-delay 2 --connect-timeout 20 --max-time 900 \
    --proxy "$PROXY" --noproxy '' --output "$file" "$URL/$file" || {
      echo "gVisor: download failed for $URL/$file; inspect host .devcontainer/firebreak/proxy/access.log" >&2
      exit 1
    }
done
sha512sum -c gvisor.tar.bz2.sha512

# Do not install unverified downloads, and keep failed ones out of /usr/local/bin.
tar -xf gvisor.tar.bz2 -C /usr/local/bin
chmod a+rx -R /usr/local/bin/runsc \
  /usr/local/bin/containerd-shim-runsc-v1 \
  /usr/local/bin/gvisor-bin/
/usr/local/bin/runsc install

# Idempotent on explicit repair and on subsequent boots.
for setting in 'user.max_user_namespaces=7182' 'kernel.yama.ptrace_scope=0' 'kernel.watchdog_thresh=30'; do
  grep -Fxq "$setting" /etc/sysctl.conf || printf '%s\n' "$setting" >> /etc/sysctl.conf
done

echo 'gVisor: bootstrap completed' >&2
EOF_GVISOR
}

render_seed() {
  configure_vm_paths "$1"
  ensure_dirs
  ensure_keys
  SANDBOX_STORAGE=$STORAGE
  if [ -f "$SECRET/storage" ]; then
    SANDBOX_STORAGE=$(cat "$SECRET/storage")
  fi
  case $SANDBOX_STORAGE in
    ephemeral|persistent) : ;;
    *) panic $EX_DATAERR "Invalid saved storage mode" ;;
  esac
  MAC=$(mac_from_string "$CLI_VERSION-$BUILD-$NAME")
  mkdir -p "$SEED"
  render_network | write_if_changed "$SEED/network-config"
  render_meta | write_if_changed "$SEED/meta-data"
  # Scripts deliberately live in cloud-init's per-instance directory: the image's
  # NoCloud datasource is only trusted to seed initial state. Reconciliation is SSH.
  # The first-boot apk install runs *with* a proxy because package modules do not
  # reliably inherit HTTP_PROXY across Alpine's OpenRC cloud-init stages.
  {
    cat <<'EOF_CLOUD'
#cloud-config
hostname: firebreak
manage_etc_hosts: true
ssh_pwauth: false
ssh:
  emit_keys_to_console: false
disable_root: false
users:
  - name: root
    passwd: "*"
    lock_passwd: false
    ssh_authorized_keys:
EOF_CLOUD
    printf '      - %s\n' "$(cat "$CLIENT.pub")"
printf '  - name: %s\n' "$GUEST_USER"
    cat <<'EOF_CLOUD'
    uid: 1000
    groups: wheel
    shell: /bin/ash
    lock_passwd: false
# Local video/serial console only: SSH password authentication stays disabled.
chpasswd:
  expire: false
  users:
EOF_CLOUD
    printf '    - name: %s\n' "$GUEST_USER"
    printf '      type: text\n'
    printf '      password: "%s"\n' "$(cat "$SECRET/console-password")"
    cat <<'EOF_CLOUD'
ssh_keys:
  ed25519_private: |
EOF_CLOUD
    while IFS= read -r line || [ -n "$line" ]; do printf '    %s\n' "$line"; done < "$HOSTKEY"
    printf '  ed25519_public: %s\n' "$(cat "$HOSTKEY.pub")"
    cat <<'EOF_CLOUD'
package_update: false
package_upgrade: false
growpart:
  mode: auto
  devices: ['/']
resize_rootfs: true
EOF_CLOUD
    if [ "$SHARE_ENABLED" = 1 ]; then
      printf 'mounts:\n'
      printf "  - ['shared', '/mnt/shared', '9p', 'trans=virtio,version=9p2000.L,ro', '0', '0']\n"
    fi
    cat <<'EOF_CLOUD'
write_files:
  - path: /var/lib/cloud/scripts/per-instance/05-firebreak-packages.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      export HTTP_PROXY=http://10.0.2.100:3128
      export HTTPS_PROXY=$HTTP_PROXY
      export http_proxy=$HTTP_PROXY
      export https_proxy=$HTTP_PROXY
      # Ensure community is present for Forgejo and its OpenRC service.
EOF_CLOUD
    printf '      grep -Fqx %s /etc/apk/repositories || printf %s >> /etc/apk/repositories\n' \
      "'${ALPINE_MIRROR%/}/v$(printf %s "$ALPINE_VERSION" | cut -d. -f1-2)/community'" \
      "'${ALPINE_MIRROR%/}/v$(printf %s "$ALPINE_VERSION" | cut -d. -f1-2)/community\\n'"
    printf '      apk update\n      apk add podman podman-compose git curl iptables qemu-guest-agent crun %s %s-openrc\n' "$FORGEJO_PACKAGE" "$FORGEJO_PACKAGE"
    cat <<'EOF_CLOUD'
  - path: /var/lib/cloud/scripts/per-instance/10-firebreak-ssh.sh
    permissions: '0755'
    content: |
EOF_CLOUD
    # The same script is available as ssh-recovery.sh on the read-only seed.
    render_ssh_recovery | sed 's/^/      /'
    cat <<'EOF_CLOUD'
  - path: /var/lib/cloud/scripts/per-instance/12-firebreak-gvisor.sh
    permissions: '0755'
    content: |
EOF_CLOUD
    # This is the *same* script used by first boot and by 'sandbox repair'.
    # Generating it once avoids having an outdated script embedded in NoCloud.
    render_gvisor_install | sed 's/^/      /'
    cat <<'EOF_CLOUD'
  - path: /var/lib/cloud/scripts/per-instance/20-firebreak-services.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      mkdir -p /etc/containers/containers.conf.d
      grep -q '^rc_cgroup_mode="unified"$' /etc/rc.conf || echo 'rc_cgroup_mode="unified"' >> /etc/rc.conf
      grep -q '^rc_cgroup_controllers=' /etc/rc.conf || echo 'rc_cgroup_controllers="cpuset cpu io memory hugetlb pids"' >> /etc/rc.conf
      rc-update add cgroups sysinit || true
      rc-service cgroups start || true
      # Podman service starts after host-selected runtime is applied over SSH.
      rc-update del podman default 2>/dev/null || :
      rc-update add qemu-guest-agent default
      rc-service qemu-guest-agent start || true
final_message: 'Firebreak NoCloud seed complete'
EOF_CLOUD
  } | write_if_changed "$SEED/user-data"
  chmod 600 "$SEED/user-data" "$SEED/network-config" "$SEED/meta-data"
  render_ssh_recovery | write_if_changed "$SEED/ssh-recovery.sh"
  chmod 600 "$SEED/ssh-recovery.sh"
  render_gvisor_install | write_if_changed "$SEED/gvisor-install.sh"
  chmod 600 "$SEED/gvisor-install.sh"
  render_guest_apply | write_if_changed "$SEED/reconcile.sh"
  chmod 600 "$SEED/reconcile.sh"
}

# Emergency SSH repair is written both to the NoCloud seed disk (for an
# already-created guest) and to the per-instance first-boot script. This path
# deliberately does not require host->guest SSH or cloud-init reruns.
render_ssh_recovery() {
  cat <<'EOF_SSH_RECOVER'
#!/bin/sh
set -eu
umask 077

# Alpine may not read sshd_config.d unless the main config includes it.
# OpenSSH uses the first value for each global directive, so include Firebreak
# policy BEFORE any preexisting settings in the main configuration.
mkdir -p /root/.ssh /etc/ssh/sshd_config.d
chmod 700 /root /root/.ssh
if [ ! -f /root/.ssh/authorized_keys ]; then
  : > /root/.ssh/authorized_keys
fi

EOF_SSH_RECOVER
  printf "if ! grep -Fqx '%s' /root/.ssh/authorized_keys; then\n" "$(cat "$CLIENT.pub")"
  printf "  printf '%%s\\\\n' '%s' >> /root/.ssh/authorized_keys\n" "$(cat "$CLIENT.pub")"
  printf 'fi\n'
  cat <<'EOF_SSH_RECOVER'
chmod 600 /root/.ssh/authorized_keys

cat > /etc/ssh/sshd_config.d/00-firebreak.conf <<'EOF'
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
AllowTcpForwarding yes
AllowStreamLocalForwarding yes
EOF
chmod 600 /etc/ssh/sshd_config.d/00-firebreak.conf

# Include must be the first directive (to avoid earlier settings winning)
config=/etc/ssh/sshd_config
first_line=$(sed -n '1p' "$config")
if [ "$first_line" != 'Include /etc/ssh/sshd_config.d/*.conf' ]; then
  tmp=$(mktemp /etc/ssh/sshd_config.firebreak.XXXXXX)
  {
    printf 'Include /etc/ssh/sshd_config.d/*.conf\n'
    cat "$config"
  } > "$tmp"
  chmod 600 "$tmp"
  if ! /usr/sbin/sshd -t -f "$tmp"; then
    rm -f "$tmp"
    echo 'Firebreak SSH recovery: proposed config is invalid; main config unchanged' >&2
    exit 1
  fi
  cp -p "$config" /etc/ssh/sshd_config.firebreak-backup
  mv -f "$tmp" "$config"
fi
/usr/sbin/sshd -t

# Verify *effective* daemon settings; merely writing a snippet is insufficient.
policy=$(/usr/sbin/sshd -T -C user=root,host=localhost,addr=10.0.2.2)
for required in 'permitrootlogin prohibit-password' \
                'passwordauthentication no' \
                'pubkeyauthentication yes' \
                'authorizedkeysfile .ssh/authorized_keys'; do
  if ! printf '%s\n' "$policy" | grep -Fxq "$required"; then
    echo "Firebreak SSH recovery: effective sshd policy missing: $required" >&2
    exit 1
  fi
done
rc-service sshd restart

printf '%s\n' 'Firebreak SSH recovery: policy verified; root public-key access configured.'
EOF_SSH_RECOVER
}

runtime_for_profile() {
  case $1 in
    unsafe) printf '%s\n' "$RUNTIME_UNSAFE" ;;
    offline) printf '%s\n' "$RUNTIME_OFFLINE" ;;
    models) printf '%s\n' "$RUNTIME_MODELS" ;;
    *) panic $EX_SOFTWARE "Unknown OCI runtime profile: $1" ;;
  esac
}

render_guest_apply() {
  # No shell-interpreted input can contain arbitrary syntax. Output writes the
  # only runtime files we own; it NEVER deletes user files or upgrades packages.
  case $SANDBOX_STORAGE in
    ephemeral) OVERLAY=all:memory ;;
    persistent) OVERLAY=none ;;
  esac
  cat <<'EOF_APPLY'
#!/bin/sh
set -eu
umask 077

profile=${1:?Expected profile}
selected_runtime=${2:?Expected OCI runtime}

case $profile in
  unsafe|models|offline) : ;;
  *) echo "Unexpected profile: $profile" >&2; exit 2 ;;
esac
case $selected_runtime in
  crun|runsc) : ;;
  *) echo "Unexpected OCI runtime: $selected_runtime" >&2; exit 2 ;;
esac
case $profile in
  unsafe) pull_policy=missing ;;
  *) pull_policy=never ;;
esac

# Avoid boot-time auto-start before Firebreak has selected the OCI runtime.
rc-update del podman default 2>/dev/null || :
mkdir -p /etc/containers/containers.conf.d /etc/containers/registries.conf.d /etc/firebreak /etc/profile.d

cat >/usr/local/bin/runsc-custom <<'EOF'
#!/bin/sh
EOF_APPLY
  printf 'exec /usr/local/bin/runsc --platform=systrap --overlay2=%s "$@"\n' "$OVERLAY"
  cat <<'EOF_APPLY'
EOF
chmod 755 /usr/local/bin/runsc-custom

policy_file=/etc/containers/containers.conf.d/99-firebreak-runsc.conf
policy_tmp=$(mktemp "${policy_file}.XXXXXX")
trap 'rm -f "$policy_tmp"' 0
trap 'exit 1' 1 2 3 15
{
  printf '[engine]\nruntime = "%s"\npull_policy = "%s"\n' "$selected_runtime" "$pull_policy"
  printf '[engine.runtimes]\nrunsc = ["/usr/local/bin/runsc-custom"]\ncrun = ["/usr/bin/crun"]\n'
} > "$policy_tmp"
if ! cmp -s "$policy_tmp" "$policy_file"; then
  mv -f "$policy_tmp" "$policy_file"
fi

# A default-runtime change does not migrate existing containers. In work mode,
# refuse to reuse unsafe-created crun containers: recreate them under runsc.
if [ "$profile" != unsafe ] && [ "$selected_runtime" = runsc ]; then
  podman ps -a --format '{{.ID}}' | while IFS= read -r container_id; do
    [ -n "$container_id" ] || continue
    original_runtime=$(podman container inspect --format '{{.OCIRuntime}}' "$container_id") || exit 1
    if [ "$original_runtime" != runsc ]; then
      printf 'Firebreak: container %s uses %s, expected runsc.\n' "$container_id" "$original_runtime" >&2
      printf 'Remove/recreate unsafe-mode containers before entering work mode (e.g. docker compose down without -v, then up).\n' >&2
      exit 1
    fi
  done
fi

policy_hash=$(sha256sum /usr/local/bin/runsc-custom "$policy_file" | sha256sum | awk '{print $1}')
previous_hash=$(cat /etc/firebreak/podman-policy-hash 2>/dev/null || true)
if ! rc-service podman status >/dev/null 2>&1; then
  rc-service podman start
elif [ "$policy_hash" != "$previous_hash" ]; then
  rc-service podman restart
fi
actual_runtime=$(podman info --format '{{.Host.OCIRuntime.Name}}')
[ "$actual_runtime" = "$selected_runtime" ] || {
  printf 'Firebreak: expected OCI runtime %s but Podman reports %s\n' "$selected_runtime" "$actual_runtime" >&2
  exit 1
}
printf '%s\n' "$policy_hash" > /etc/firebreak/podman-policy-hash

EOF_APPLY
  printf "printf '%%s\\\\n' '%s' > /etc/firebreak/storage\n" "$SANDBOX_STORAGE"
  # Guest-only Forgejo password, never an external provider credential.
  printf "printf '%%s\\\\n' '%s' > /etc/firebreak/forgejo-password\n" "$(cat "$SECRET/forgejo-password")"
  printf "printf '%%s\\\\n' '%s' > /etc/firebreak/forgejo-worker-password\n" "$(cat "$SECRET/forgejo-worker-password")"
  printf "printf '%%s\\\\n' 'http://firebreak:%s@127.0.0.1:%s' > /etc/firebreak/forgejo-credentials\n" \
    "$(cat "$SECRET/forgejo-password")" "$FORGEJO_PORT"
  cat <<'EOF_APPLY'
chmod 600 /etc/firebreak/forgejo-password /etc/firebreak/forgejo-worker-password /etc/firebreak/forgejo-credentials
EOF_APPLY
  printf 'FIREBREAK_WORKER_PORT=%s\n' "$FORGEJO_PORT"
  cat <<'EOF_APPLY'

# Forgejo packaging has a dedicated forgejo:www-data user on Alpine.
if command -v forgejo >/dev/null 2>&1; then
  mkdir -p /etc/forgejo /var/lib/forgejo /var/log/forgejo
  chown forgejo:www-data /var/lib/forgejo /var/log/forgejo
  chmod 750 /var/lib/forgejo
  # This app.ini is Firebreak-managed; reconcile the port and security policy.
  forgejo_changed=no
  cat > /etc/forgejo/app.ini.firebreak-new <<'EOF'
APP_NAME = Firebreak
RUN_MODE = prod

[database]
DB_TYPE = sqlite3
PATH = /var/lib/forgejo/data/forgejo.db

[server]
HTTP_ADDR = 0.0.0.0
EOF_APPLY
  printf 'HTTP_PORT = %s\nROOT_URL = http://127.0.0.1:%s/\n' "$FORGEJO_PORT" "$FORGEJO_PORT"
  cat <<'EOF_APPLY'
DISABLE_SSH = true
OFFLINE_MODE = true

[security]
INSTALL_LOCK = true
EOF_APPLY
  printf 'SECRET_KEY = %s\n' "$(cat "$SECRET/forgejo-secret")"
  cat <<'EOF_APPLY'

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = false
ENABLE_NOTIFY_MAIL = false

[repository]
DEFAULT_PRIVATE = private
# Generate POSIX-compliant /bin/sh hooks
SCRIPT_TYPE = sh
EOF
  chown forgejo:www-data /etc/forgejo/app.ini.firebreak-new
  chmod 640 /etc/forgejo/app.ini.firebreak-new
  if ! cmp -s /etc/forgejo/app.ini.firebreak-new /etc/forgejo/app.ini; then
    mv -f /etc/forgejo/app.ini.firebreak-new /etc/forgejo/app.ini
    forgejo_changed=yes
  else
    rm -f /etc/forgejo/app.ini.firebreak-new
  fi

  if [ ! -f /etc/firebreak/forgejo-initialized ]; then
    # Run once, *as the package's service user*, never as root.
    su -s /bin/sh forgejo -c 'forgejo --work-path /var/lib/forgejo --config /etc/forgejo/app.ini migrate'
EOF_APPLY
  printf "    su -s /bin/sh forgejo -c 'forgejo --work-path /var/lib/forgejo --config /etc/forgejo/app.ini admin user create --username firebreak --email firebreak@localhost.invalid --password %s --admin --must-change-password=false'\n" "$(cat "$SECRET/forgejo-password")"
  cat <<'EOF_APPLY'
    touch /etc/firebreak/forgejo-initialized
  fi
  rc-update add forgejo default || true
  if [ "$forgejo_changed" = yes ]; then
    rc-service forgejo restart || rc-service forgejo start
  else
    rc-service forgejo status >/dev/null 2>&1 || rc-service forgejo start
  fi

  # The worker is a non-admin, isolated Forgejo identity. Its generated
  # password is only a provisioning/recovery credential. A second phase
  # after Git import grants repo access.
  worker_api="http://127.0.0.1:$FIREBREAK_WORKER_PORT/api/v1"
  worker_pass=$(cat /etc/firebreak/forgejo-worker-password)
  # OpenRC may report started before Forgejo's HTTP listener is ready.
  worker_code=000
  worker_try=0
  while [ "$worker_try" -lt 30 ]; do
    worker_code=$(curl -sS --connect-timeout 2 --max-time 5 -o /dev/null -w '%{http_code}'       -u "firebreak:$(cat /etc/firebreak/forgejo-password)"       "$worker_api/users/sbx-worker" 2>/dev/null) || worker_code=000
    case $worker_code in
      200|404) break ;;
      000) : ;;
      *) break ;;
    esac
    worker_try=$((worker_try + 1))
    sleep 1
  done
  case "$worker_code" in
    404)
      # Static arguments; the password is generated hex, never shell input.
      su -s /bin/sh forgejo -c \
        "forgejo --work-path /var/lib/forgejo --config /etc/forgejo/app.ini admin user create --username sbx-worker --email sbx-worker@firebreak.invalid --password $worker_pass --must-change-password=false"
      ;;
    200) : ;;
    *) echo "Forgejo worker lookup failed: HTTP $worker_code" >&2; exit 1 ;;
  esac

  # If interrupted between creation and marking success, the worker may
  # already exist. Only adopt it if the Firebreak-managed password works.
  verified=$(curl -fsS -u "sbx-worker:$worker_pass" "$worker_api/user") || {
    echo 'Existing sbx-worker is not the Firebreak-managed account' >&2; exit 1;
  }
  printf '%s' "$verified" | grep -Eq '"login"[[:space:]]*:[[:space:]]*"sbx-worker"' || exit 1
  if printf '%s' "$verified" | grep -Eq '"is_admin"[[:space:]]*:[[:space:]]*true'; then
    echo 'Refusing privileged Forgejo worker account' >&2; exit 1
  fi

  # The Forgejo CLI runs under its own service UID; never leak token to log.
  if [ ! -s /etc/firebreak/forgejo-worker-token ]; then
    # Forgejo CLI versions accept --scopes (older) or --scope (newer).
    token_help=$(su -s /bin/sh forgejo -c \
      'forgejo --work-path /var/lib/forgejo --config /etc/forgejo/app.ini admin user generate-access-token --help' 2>&1) || {
      echo 'Cannot inspect Forgejo token-generation options' >&2; exit 1;
    }
    case "$token_help" in
      *--scopes*) scope_option='--scopes write:repository' ;;
      *--scope*)  scope_option='--scope write:repository' ;;
      *) echo 'Forgejo cannot create a repository-scoped worker token' >&2; exit 1 ;;
    esac
    token_tmp=$(mktemp /etc/firebreak/forgejo-worker-token.XXXXXX)
    if ! su -s /bin/sh forgejo -c \
      "forgejo --work-path /var/lib/forgejo --config /etc/forgejo/app.ini admin user generate-access-token --username sbx-worker --token-name firebreak-git $scope_option --raw" > "$token_tmp"; then
      rm -f "$token_tmp"
      echo 'Could not create Forgejo worker access token' >&2; exit 1
    fi
    [ -s "$token_tmp" ] || { rm -f "$token_tmp"; exit 1; }
    tr -d '\r\n' < "$token_tmp" > "$token_tmp.clean"
    mv -f "$token_tmp.clean" /etc/firebreak/forgejo-worker-token
    rm -f "$token_tmp"
  fi
  chmod 600 /etc/firebreak/forgejo-worker-token

  # A stable VM-local capability for project-owned Compose configurations.
  # It contains only the NON-ADMIN worker token, never admin credentials.
  # Allow traversal of /var/lib/firebreak without exposing its directory list.
  [ ! -L /var/lib/firebreak ] || { echo 'Refusing symlinked Firebreak state' >&2; exit 1; }
  [ ! -L /var/lib/firebreak/worker-runtime ] || { echo 'Refusing symlinked worker runtime' >&2; exit 1; }
  run=/var/lib/firebreak/worker-runtime
  mkdir -p "$run"
  chmod 711 /var/lib/firebreak "$run"
  cred_tmp=$(mktemp "$run/credentials.XXXXXX")
  token=$(cat /etc/firebreak/forgejo-worker-token)
  printf 'http://sbx-worker:%s@127.0.0.1:%s\n' "$token" "$FIREBREAK_WORKER_PORT" > "$cred_tmp"
  printf 'http://sbx-worker:%s@host.containers.internal:%s\n' "$token" "$FIREBREAK_WORKER_PORT" >> "$cred_tmp"
  unset token
  if [ -f "$run/git-credentials" ] && cmp -s "$cred_tmp" "$run/git-credentials"; then
    rm -f "$cred_tmp"
  else
    mv -f "$cred_tmp" "$run/git-credentials"
  fi
  # Existing Compose projects use UID 1000. Projects running as another UID
  # can choose a different credential delivery method in their own Compose.
  chown 1000:1000 "$run/git-credentials"
  chmod 400 "$run/git-credentials"
  helper_tmp=$(mktemp "$run/helper.XXXXXX")
  cat > "$helper_tmp" <<'EOF_WORKER_HELPER'
#!/bin/sh
case ${1:-} in
  get) exec git credential-store --file="${FIREBREAK_GIT_CREDS:-/run/firebreak/git-credentials}" get ;;
  store|erase) cat >/dev/null ;;
  *) exit 1 ;;
esac
EOF_WORKER_HELPER
  if [ -f "$run/git-credential-helper" ] && cmp -s "$helper_tmp" "$run/git-credential-helper"; then
    rm -f "$helper_tmp"
  else
    mv -f "$helper_tmp" "$run/git-credential-helper"
  fi
  chown 0:0 "$run/git-credential-helper"
  chmod 555 "$run/git-credential-helper"
fi
EOF_APPLY
