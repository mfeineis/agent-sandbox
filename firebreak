    printf '    "ghcr.io/%s/%s/claude-code:%s": {\n' "$SBX_OWNER" "$SBX_REPO" "$SBX_VERSION"
    printf '      "claudeCodeVersion": "%s"\n' "$SBX_AGENT_VERSION"
    printf '    }\n'
    cat <<'DEVCONFOOT'
