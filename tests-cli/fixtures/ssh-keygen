#!/bin/sh
# Test-only fake: not a real cryptographic key. Never use in production.
while [ "$#" -gt 0 ]; do
  case "$1" in -f) dest=$2; shift 2;; *) shift;; esac
done
[ -n "${dest:-}" ] || exit 1
printf '%s\n' '-----BEGIN OPENSSH PRIVATE KEY-----' 'test-only-fake' '-----END OPENSSH PRIVATE KEY-----' > "$dest"
printf '%s\n' 'ssh-ed25519 AAAATESTONLYNOTAREALKEY test' > "$dest.pub"
